# 信科 Link 生产环境变量清单模板
# 部署时复制到 /etc/xinkelink/xinkelink.env，并执行：
#   sudo chown root:xinkelink /etc/xinkelink/xinkelink.env
#   sudo chmod 640 /etc/xinkelink/xinkelink.env
# 严禁将填写真实密钥的文件提交到 Git 仓库！

# ========= 1. MySQL 8.4（必须显式 UTC 时区）=========
XINKELINK_DB_URL=jdbc:mysql://127.0.0.1:3306/xinkelink_prod?useUnicode=true&characterEncoding=utf8mb4&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# 运行时最小权限账号（禁止授予 DROP / ALTER / 审计表 DELETE）
XINKELINK_DB_USERNAME=xinkelink_app
XINKELINK_DB_PASSWORD=REPLACE_WITH_STRONG_APP_DB_PASSWORD
# Flyway 迁移专用账号（具备 DDL 权限，仅启动迁移阶段使用）
XINKELINK_MIGRATION_USERNAME=xinkelink_migrator
XINKELINK_MIGRATION_PASSWORD=REPLACE_WITH_STRONG_MIGRATION_DB_PASSWORD

# ========= 2. Redis 7 =========
XINKELINK_REDIS_HOST=127.0.0.1
XINKELINK_REDIS_PORT=6379
XINKELINK_REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ========= 3. 认证与微信配置 =========
# 至少 32 字节随机密钥的 Base64，生成命令：openssl rand -base64 48
XINKELINK_JWT_SECRET_BASE64=REPLACE_WITH_OPENSSL_RAND_BASE64_48
XINKELINK_WECHAT_APP_ID=wxda2ce56da7fced57
XINKELINK_WECHAT_APP_SECRET=REPLACE_WITH_WECHAT_APP_SECRET

# 管理后台真实 HTTPS Origin（多个用逗号分隔，不要带尾部斜杠）
XINKELINK_ADMIN_ALLOWED_ORIGINS=https://your-domain.example.com

# ========= 4. 内容安全（微信 msg_sec_check）=========
# 生产必须开启；fail-open 默认 false（微信接口异常时宁可拒发不放行）
XINKELINK_WECHAT_CONTENT_CHECK_ENABLED=true
XINKELINK_WECHAT_CONTENT_CHECK_FAIL_OPEN=false

# ========= 5. 阿里云 OSS 图片存储 =========
XINKELINK_IMAGE_STORAGE=oss
XINKELINK_IMAGE_DIRECTORY=/var/lib/xinkelink/images-fallback
XINKELINK_OSS_BUCKET=REPLACE_WITH_PROD_BUCKET_NAME
XINKELINK_OSS_REGION=cn-beijing
XINKELINK_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
XINKELINK_OSS_ACCESS_KEY_ID=REPLACE_WITH_RAM_OSS_AK
XINKELINK_OSS_ACCESS_KEY_SECRET=REPLACE_WITH_RAM_OSS_SK

# ========= 6. V1.0 首版关闭非必要中间件（4GB 单机稳态）=========
XINKELINK_VIEW_ENABLED=false
XINKELINK_NOTIFICATION_MQ_ENABLED=false
XINKELINK_POST_METRICS_CDC_ENABLED=false
XINKELINK_POST_METRICS_CACHE_ENABLED=true
XINKELINK_POST_METRICS_L1_ENABLED=true
