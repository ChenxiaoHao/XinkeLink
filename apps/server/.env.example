# 只提供变量名与示例地址；实际值由启动环境注入，本文件不会自动加载。
XINKELINK_DB_URL=jdbc:mysql://127.0.0.1:13306/xinkelink_dev?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
XINKELINK_DB_USERNAME=
XINKELINK_DB_PASSWORD=
XINKELINK_MIGRATION_USERNAME=
XINKELINK_MIGRATION_PASSWORD=

# auth profile依赖Redis7.x限流；redis profile额外开启健康检查，不连接系统旧Redis。
XINKELINK_REDIS_HOST=127.0.0.1
XINKELINK_REDIS_PORT=16379
XINKELINK_REDIS_PASSWORD=

# 启用auth profile时必填随机JWT密钥(Base64编码、至少32字节)，禁止使用演示默认值。
XINKELINK_JWT_SECRET_BASE64=
XINKELINK_WECHAT_APP_ID=
XINKELINK_WECHAT_APP_SECRET=
# 管理后台真实Origin，多个值用逗号分隔；浏览器刷新Cookie还需要HTTPS。
XINKELINK_ADMIN_ALLOWED_ORIGINS=

# local/oss二选一；OSS模式保留旧图的本地读取，不自动迁移或删除。
XINKELINK_IMAGE_STORAGE=local
XINKELINK_IMAGE_DIRECTORY=.local/backend-images
XINKELINK_OSS_BUCKET=
XINKELINK_OSS_REGION=cn-beijing
XINKELINK_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
XINKELINK_OSS_ACCESS_KEY_ID=
XINKELINK_OSS_ACCESS_KEY_SECRET=
