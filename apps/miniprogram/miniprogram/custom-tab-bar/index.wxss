@import "../styles/tokens.wxss";

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  box-sizing: content-box;
  height: 104rpx;
  padding-bottom: 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  overflow: visible;
  background: var(--xlk-color-surface);
  border-top: 1rpx solid var(--xlk-color-border);
}
.tab-slot { flex: 1 1 0%; width: 0; min-width: 0; height: 100%; display: flex; align-items: center; justify-content: center; box-sizing: border-box; overflow: visible; }
/* Two classes override the style:v2 wx-button:not([size=mini]) width. */
.tab-bar .tab-item { width: 100%; min-width: 0; max-width: 100%; height: 100%; box-sizing: border-box; margin: 0; padding: 8rpx 0; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 0; border-radius: 0; background: transparent; color: var(--xlk-color-muted); font-weight: 400; line-height: 1.4; }
.tab-bar .tab-item::after, .tab-bar .publish-button::after { border: 0; }
.tab-bar .tab-item--active { color: var(--xlk-color-primary); }
.tab-bar .tab-item--pressed { background: var(--xlk-color-primary-soft); }
.tab-icon { width: 36rpx; height: 36rpx; }
.tab-label { margin-top: 4rpx; font-size: 20rpx; }
.tab-bar .publish-button { display: flex; align-items: center; justify-content: center; flex: 0 0 88rpx; width: 88rpx; min-width: 88rpx; max-width: 88rpx; height: 88rpx; box-sizing: border-box; margin: -12rpx 0 0; padding: 0; border: 0; border-radius: 50%; background: var(--xlk-color-primary); box-shadow: var(--xlk-shadow-button); line-height: 1; }
.tab-bar .publish-button--pressed { opacity: 0.85; }
.publish-icon { width: 44rpx; height: 44rpx; }
