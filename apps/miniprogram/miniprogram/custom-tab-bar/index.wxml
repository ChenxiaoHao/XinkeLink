<view class="xlk-theme">
 <view wx:if="{{!drawerVisible}}" class="tab-bar {{selectionMotion ? 'tab-bar--motion' : ''}}">
  <button wx:for="{{tabs}}" wx:key="key" class="tab-item {{activeKey === item.key ? 'tab-item--active' : ''}}" data-key="{{item.key}}" bindtap="onTabTap" hover-class="tab-item--pressed" aria-label="{{item.label}}" aria-role="button">
   <view wx:if="{{activeKey === item.key}}" class="tab-dot"></view>
   <image class="tab-icon" src="/assets/icons/x-{{item.icon}}-{{activeKey === item.key ? 'active' : 'ink'}}.png" mode="aspectFit" />
   <text wx:if="{{(item.key === 'contact' && messageUnread) || (item.key === 'notifications' && notificationUnread)}}" class="tab-unread-badge">{{item.key === 'contact' ? (messageUnread > 99 ? '99+' : messageUnread) : (notificationUnread > 99 ? '99+' : notificationUnread)}}</text>
  </button>
 </view>
 <button wx:if="{{!drawerVisible && (activeKey === 'forum' || activeKey === 'search' || activeKey === 'notifications' || activeKey === 'contact')}}" class="publish-button" bindtap="onFab" hover-class="publish-button--pressed" aria-label="{{activeKey === 'contact' ? '发起新对话' : '发布'}}"><image class="publish-icon" src="/assets/icons/{{activeKey === 'contact' ? 'x-square-pen-white' : 'plus-white'}}.png" /></button>
</view>