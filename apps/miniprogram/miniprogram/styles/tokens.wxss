/* 唯一设计来源：颜色 / 字号 / 行高 / 控件高度 / 圆角 / 间距。
   数值口径是 375 逻辑宽（设计稿 px），WXSS 里统一 ×2 写成 rpx；
   ≥500px 的窄平板按 px 还原，避免 rpx 被放大得过大。
   Custom tabBar 在页面之外，所以 .xlk-theme 需要一套同样的变量。 */
page, .xlk-theme {
  /* 颜色 */
  --xlk-color-primary: #0F1419;
  --xlk-color-primary-strong: #0f1419;
  --xlk-color-primary-soft: #EFF3F4;
  --xlk-color-background: #FFFFFF;
  --xlk-color-surface: #FFFFFF;
  --xlk-color-text: #0F1419;
  --xlk-color-muted: #536471;
  --xlk-color-border: #EFF3F4;
  --xlk-color-band: #F7F9F9;
  --xlk-color-image-border: #CFD9DE;
  --xlk-color-like: #F91880;
  --xlk-color-repost: #00BA7C;
  --xlk-color-announce: #7856FF;
  --xlk-color-danger: #F4212E;

  /* 间距（8 的倍数） */
  --xlk-space-1: 8rpx;
  --xlk-space-2: 16rpx;
  --xlk-space-3: 24rpx;
  --xlk-space-4: 32rpx;
  --xlk-space-6: 48rpx;
  --xlk-space-8: 64rpx;

  /* 圆角 */
  --xlk-radius-sm: 16rpx;
  --xlk-radius-md: 24rpx;
  --xlk-radius-lg: 32rpx;
  --xlk-radius-sheet: 32rpx;
  --xlk-radius-pill: 999px;

  /* 字号 */
  --xlk-font-title: 40rpx;
  --xlk-font-heading: 34rpx;
  --xlk-font-body: 30rpx;
  --xlk-font-label: 28rpx;
  --xlk-font-caption: 26rpx;
  --xlk-font-tiny: 24rpx;
  --xlk-font-menu: 40rpx;

  /* 行高 */
  --xlk-line-body: 40rpx;
  --xlk-line-detail: 42rpx;
  --xlk-line-editor: 48rpx;
  --xlk-line-caption: 36rpx;

  /* 控件高度 */
  --xlk-h-topbar: 106rpx;
  --xlk-h-tab: 106rpx;
  --xlk-h-nav: 106rpx;
  --xlk-h-toolbar: 68rpx;
  --xlk-h-action: 68rpx;
  --xlk-h-action-detail: 88rpx;
  --xlk-h-row: 104rpx;
  --xlk-h-composer: 104rpx;

  /* 尺寸 */
  --xlk-size-avatar: 80rpx;
  --xlk-size-avatar-sm: 64rpx;
  --xlk-size-avatar-xs: 56rpx;
  --xlk-size-avatar-profile: 176rpx;
  --xlk-size-icon-action: 36rpx;
  --xlk-size-icon-nav: 52rpx;
  --xlk-size-fab: 112rpx;

  --xlk-shadow-card: none;
  --xlk-shadow-button: 0 3rpx 10rpx rgba(61, 99, 142, 0.15);
  --xlk-ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  --xlk-ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);
}

/* tablet-scale:begin */
@media (min-width: 500px) {
page, .xlk-theme {
  --xlk-space-1: 4px;
  --xlk-space-2: 8px;
  --xlk-space-3: 12px;
  --xlk-space-4: 16px;
  --xlk-space-6: 24px;
  --xlk-space-8: 32px;
  --xlk-radius-sm: 8px;
  --xlk-radius-md: 12px;
  --xlk-radius-lg: 16px;
  --xlk-radius-sheet: 16px;
  --xlk-font-title: 20px;
  --xlk-font-heading: 17px;
  --xlk-font-body: 15px;
  --xlk-font-label: 14px;
  --xlk-font-caption: 13px;
  --xlk-font-tiny: 12px;
  --xlk-font-menu: 20px;
  --xlk-line-body: 20px;
  --xlk-line-detail: 21px;
  --xlk-line-editor: 24px;
  --xlk-line-caption: 18px;
  --xlk-h-topbar: 53px;
  --xlk-h-tab: 53px;
  --xlk-h-nav: 53px;
  --xlk-h-toolbar: 34px;
  --xlk-h-action: 34px;
  --xlk-h-action-detail: 44px;
  --xlk-h-row: 52px;
  --xlk-h-composer: 52px;
  --xlk-size-avatar: 40px;
  --xlk-size-avatar-sm: 32px;
  --xlk-size-avatar-xs: 28px;
  --xlk-size-avatar-profile: 88px;
  --xlk-size-icon-action: 18px;
  --xlk-size-icon-nav: 26px;
  --xlk-size-fab: 56px;
  --xlk-shadow-button: 0 1.5px 5px rgba(61, 99, 142, 0.15);
}
}
/* tablet-scale:end */
