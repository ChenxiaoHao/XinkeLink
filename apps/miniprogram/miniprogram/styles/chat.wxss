/* Contact chat: X DM style — peer avatar + name in topbar, bottom-aligned peer-only avatar, crisp #EFF3F4 / #0F1419 bubbles, unified floating pill composer. */
.contact-chat-page { background: #FFFFFF; color: #0F1419; --profile-auth-primary: #0F1419; }
.contact-chat-page .chat-header { position: relative; background: #FFFFFF; }
.contact-chat-page .chat-header::after { position: absolute; right: 0; bottom: 0; left: 0; height: 1rpx; background: #EFF3F4; content: ''; pointer-events: none; }
.contact-chat-page .chat-header .chat-peer-title {
  position: absolute;
  bottom: 0;
  left: 44px;
  right: 156px;
  display: flex;
  align-items: center;
  gap: 8px;
  height: 44px;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border-radius: 0;
  background: transparent;
  color: #0F1419;
  font-size: 16px;
  font-weight: 700;
  line-height: 44px;
  text-align: left;
}
.contact-chat-page .chat-header .chat-peer-title[disabled] { color: #0F1419; background: transparent; }
.contact-chat-page .chat-header-avatar { width: 28px; height: 28px; border-radius: 50%; flex: none; background: #EFF3F4; }
.contact-chat-page .chat-peer-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.contact-chat-page .chat-header .chat-settings-entry { position: absolute; right: 112px; bottom: 0; display: flex; align-items: center; justify-content: center; width: 44px; min-width: 44px; height: 44px; margin: 0; padding: 0; border-radius: 50%; background: transparent; }
.contact-chat-page .chat-settings-entry image { width: 20px; height: 20px; }
.contact-chat-page .chat-peer-title:active, .contact-chat-page .chat-settings-entry:active { opacity: .7; }

.contact-chat-page .contact-chat { display: flex; flex-direction: column; box-sizing: border-box; padding-top: 0; background: #FFFFFF; }
.contact-chat-page .chat-chevron { width: 12px; height: 12px; margin-left: -4px; flex: none; }
.contact-chat-page .chat-messages { flex: 1; height: 0; min-height: 0; width: 100%; }
.contact-chat-page .chat-message-list { display: flex; flex-direction: column; justify-content: flex-end; min-height: 100%; padding-bottom: 6px; box-sizing: border-box; }
.contact-chat-page .chat-message-list--empty { justify-content: center; }
.contact-chat-page .chat-date { flex: none; margin: 16px 0 14px; padding: 0 16px; text-align: center; font-size: 11.5px; color: #8B98A5; }

/* X DM message rows: bottom-aligned small avatar for peer only; no self avatar */
.contact-chat-page .chat-message { display: flex; align-items: flex-end; flex: none; margin: 0 16px 12px; gap: 8px; }
.contact-chat-page .chat-avatar { width: 28px; height: 28px; border-radius: 50%; flex: none; background: #EFF3F4; }
.contact-chat-page .chat-message-content { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; max-width: 74vw; }
.contact-chat-page .chat-sender-name { display: none; }
.contact-chat-page .chat-bubble {
  display: block;
  max-width: 100%;
  box-sizing: border-box;
  padding: 11px 15px;
  border: 0;
  border-radius: 20px 20px 20px 4px;
  background: #EFF3F4;
  color: #0F1419;
  font-size: 15px;
  line-height: 22px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.contact-chat-page .chat-message--self { flex-direction: row-reverse; }
.contact-chat-page .chat-message--self .chat-avatar { display: none; }
.contact-chat-page .chat-message--self .chat-message-content { align-items: flex-end; }
.contact-chat-page .chat-message--self .chat-bubble {
  border-radius: 20px 20px 4px 20px;
  background: #0F1419;
  color: #FFFFFF;
}
.contact-chat-page .chat-send-status { margin: 4px 2px 0; font-size: 11px; line-height: 16px; color: #8B98A5; text-align: right; }
.contact-chat-page .chat-message--failed .chat-bubble { border: 1rpx solid #EDBFC2; background: #FDF3F4; color: #0F1419; }
.contact-chat-page .chat-message-content .chat-retry-send { position: relative; display: flex; align-items: center; justify-content: flex-end; min-height: 16px; width: auto; min-width: 44px; margin: 4px 0 0 !important; padding: 0; border-radius: 0; background: transparent; color: #F4212E; font-size: 12px; line-height: 16px; text-align: right; }
.contact-chat-page .chat-retry-send::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 44px; }

.contact-chat-page .chat-safety { padding: 8px 16px 12px; color: #8B98A5; font-size: 11px; text-align: center; }
.contact-chat-page .chat-read-warning { flex: none; padding: 6px 16px; background: #EDF1F6; color: #526780; font-size: 12px; line-height: 1.6; text-align: center; }

/* X DM unified floating capsule composer */
.contact-chat-page .chat-composer {
  display: flex;
  align-items: center;
  flex: none;
  padding: 8px 14px calc(10px + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 0;
}
.contact-chat-page .chat-input-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  box-sizing: border-box;
  padding: 5px 5px 5px 18px;
  border-radius: 999px;
  background: #EFF3F4;
}
.contact-chat-page .chat-input {
  flex: 1;
  min-width: 0;
  height: 36px;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #0F1419;
  font-size: 15px;
}
.contact-chat-page .chat-composer .chat-send {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 34px;
  min-width: 34px;
  max-width: 34px;
  height: 34px;
  margin: 0 !important;
  padding: 0;
  border-radius: 50%;
  background: #0F1419;
  transition: transform 140ms var(--xlk-ease-out), opacity 140ms ease;
}
.contact-chat-page .chat-send image { width: 17px; height: 17px; }
.contact-chat-page .chat-composer .chat-send[disabled] { background: #0F1419; opacity: 0.28; }
.contact-chat-page .chat-composer .chat-send:active { transform: scale(.94); }

.contact-chat-page .chat-blocked { display: flex; align-items: center; justify-content: space-between; flex: none; box-sizing: border-box; height: 46px; padding: 0 16px; border-top: 1rpx solid #EFF3F4; background: #F7F9F9; text-align: left; }
.contact-chat-page .chat-blocked-text { flex: 1; min-width: 0; color: #536471; font-size: 12.5px; line-height: 1.4; }
.contact-chat-page .chat-blocked .chat-blocked-action { display: flex; align-items: center; flex: none; width: auto; min-width: 44px; height: 44px; margin: 0 0 0 8px !important; padding: 0; border-radius: 0; background: transparent; color: #0F1419; font-size: 12.5px; font-weight: 700; line-height: 1.4; }
.contact-chat-page .chat-empty { display: flex; flex-direction: column; align-items: center; box-sizing: border-box; flex: none; padding: 0 16px; gap: 8px; text-align: center; }
.contact-chat-page .chat-empty-avatar { width: 52px; height: 52px; border-radius: 50%; }
.contact-chat-page .chat-empty-title { color: #0F1419; font-size: 16px; font-weight: 700; }
.contact-chat-page .chat-empty-copy { color: #536471; font-size: 13px; }
.contact-chat-page .chat-state, .contact-chat-page .chat-missing { display: flex; flex-direction: column; align-items: center; padding: 60px 16px; color: #536471; text-align: center; }
.contact-chat-page .chat-state-icon { width: 46px; height: 46px; margin-bottom: 12px; }
.contact-chat-page .chat-state-title { color: #0F1419; font-size: 16px; font-weight: 700; }
.contact-chat-page .chat-state-copy { margin-top: 6px; font-size: 13px; }
.contact-chat-page .chat-state .chat-state-action { min-height: 44px; width: auto; min-width: 0; margin: 24px 0 0; padding: 0 20px; border-radius: 22px; background: #0F1419; color: #FFFFFF; font-size: 14px; font-weight: 500; line-height: 44px; }
@media (prefers-reduced-motion: reduce) { .contact-chat-page .chat-composer .chat-send { transition: none; transform: none; } }
@media (min-width: 500px) {
  .contact-chat-page .chat-message-content { max-width: 340px; }
}
