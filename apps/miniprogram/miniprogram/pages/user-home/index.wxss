/* 他人主页：与个人主页同一套 X 式骨架，右侧按钮换成私信。 */
.user-home { min-height:100vh; background:#fff; padding-bottom:calc(32px + env(safe-area-inset-bottom)); }

.user-cover { position:relative; height:150px; background:linear-gradient(118deg,#0b4c78 0%,#0f1419 58%,#7fd0f7 100%); }
.user-nav { position:absolute; top:0; left:0; right:0; display:flex; align-items:center; justify-content:space-between; height:53px; padding-left:12px; box-sizing:content-box; }
.user-nav-button { display:flex; align-items:center; justify-content:center; width:34px; min-width:34px; max-width:34px; height:34px; min-height:34px; max-height:34px; margin:0; padding:0; border-radius:17px; background:rgba(0,0,0,.42); }
.user-nav-button image { width:18px; height:18px; }
.user-nav-button:active { background:rgba(0,0,0,.58); }

.user-identity { padding:0 16px; }
/* 封面是定位元素，会盖住静态流里的头像；显式抬高层级才能让头像真的压在封面上。 */
/* 88 是含白色描边的外径（设计稿口径）。 */
.user-avatar { display:block; position:relative; z-index:1; box-sizing:border-box; width:88px; height:88px; margin-top:-36px; border:4px solid #fff; border-radius:50%; background:#fff; }
.user-name { display:block; margin-top:4px; color:#0f1419; font-size:20px; font-weight:800; line-height:26px; overflow-wrap:anywhere; }
.user-meta { display:block; margin-top:2px; color:#536471; font-size:15px; line-height:20px; overflow-wrap:anywhere; }
.user-bio { display:block; margin-top:10px; color:#0f1419; font-size:15px; line-height:20px; overflow-wrap:anywhere; }
.user-stats { display:flex; gap:20px; margin-top:12px; }
.user-stat { display:flex; align-items:baseline; gap:4px; }
.user-stat-number { color:#0f1419; font-size:15px; font-weight:700; line-height:20px; }
.user-stat-unit { color:#536471; font-size:15px; line-height:20px; }
.user-actions { display:flex; gap:8px; margin-top:12px; }
.user-action { flex:1; min-width:0; height:36px; margin:0; padding:0 8px; border:1px solid #cfd9de; border-radius:18px; background:#fff; color:#0f1419; font-size:14px; font-weight:700; line-height:34px; text-align:center; }
.user-action:active { background:#f7f9f9; }

.user-preview { margin:12px 16px 0; padding:10px 12px; border-radius:12px; background:#f7f9f9; color:#536471; font-size:13px; line-height:18px; }

.user-tabs { display:flex; margin-top:16px; border-bottom:1px solid #eff3f4; }
.user-tab { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; height:48px; margin:0; padding:0; background:transparent; border-radius:0; color:#0f1419; font-size:15px; font-weight:700; }
.user-tab text { line-height:20px; }
.user-tab-underline { width:56px; height:4px; margin-top:6px; border-radius:2px; background:#0f1419; }

.user-post { border-bottom:1px solid #eff3f4; }
.user-end { padding:24px 16px; text-align:center; color:#536471; font-size:13px; }

.user-state { padding:48px 32px; text-align:center; }
.user-state-title { display:block; color:#0f1419; font-size:20px; font-weight:800; line-height:26px; }
.user-state-copy { display:block; margin-top:8px; color:#536471; font-size:15px; line-height:20px; }
.user-state-action { width:max-content; min-width:0; margin:20px auto 0 !important; padding:0 20px; height:36px; border-radius:18px; background:#0f1419; color:#fff; font-size:15px; font-weight:700; line-height:36px; }

@media (min-width: 500px) {
  .user-home { max-width:460px; margin:0 auto; }
}
