<view class="report-header"><back-header title="举报内容" /></view>
<view wx:if="{{targetMissing}}" class="report-unavailable"><text>举报对象暂时无法读取</text><text>请返回上一页后重试。</text></view>
<view wx:else class="report-page">
  <view class="report-privacy"><image src="/assets/icons/shield-check-primary.png" /><text>举报内容需客观描述事实，平台会按规则处理。</text></view>
  <view class="report-target"><text>举报对象</text><text>{{targetTitle}}</text></view>
  <view class="report-section-title"><text>举报原因 <text class="report-required">*</text></text><text>单选</text></view>
  <view class="report-reasons"><button wx:for="{{reasons}}" wx:key="*this" class="report-reason {{reason === item ? 'report-reason--selected' : ''}}" data-reason="{{item}}" bindtap="onReasonTap"><text>{{item}}</text><radio color="#222223" checked="{{reason === item}}" /></button></view>
  <view class="report-section-title report-detail-heading"><text>详细说明 <text class="report-required">*</text></text><text>客观描述违规事实细节</text></view>
  <view class="report-detail-box"><textarea value="{{detail}}" maxlength="200" placeholder="请简要描述违规事实或说明细节（必填，200字以内）…" bindinput="onDetailInput" /><text>{{detail.length}}/200</text></view>
  <view class="report-section-title"><text>证据截图上传</text><text>选填，最多 3 张</text></view>
  <view class="report-evidence"><view wx:for="{{evidence}}" wx:key="*this" class="report-evidence-image"><image src="{{item}}" mode="aspectFill" /><button data-index="{{index}}" bindtap="onRemoveEvidence" aria-label="删除第{{index + 1}}张证据图片"><image src="/assets/icons/x-muted.png" mode="aspectFit" /></button></view><button wx:if="{{evidence.length < 3}}" class="report-evidence-add" bindtap="onChooseEvidence"><image src="/assets/icons/camera-primary.png" /><text>添加截图</text></button></view>
  <view class="report-local-note">请如实提供线索，避免重复提交。</view>
  <button class="report-submit" bindtap="onSubmitReport" loading="{{submitting}}" disabled="{{submitting}}">提交举报</button>
</view>
<profile-auth-sheet visible="{{authVisible}}" busy="{{authSaving}}" error="{{authError}}" bind:confirm="onProfileAuthConfirm" bind:cancel="onProfileAuthCancel" />
