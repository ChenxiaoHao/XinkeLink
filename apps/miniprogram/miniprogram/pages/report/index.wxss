page {
  background: #ffffff;
  color: #0f1419;
  --profile-auth-primary: #0f1419;
}
.report-header { position: sticky; top: 0; z-index: 20; background: #fff; }
.report-page { padding: 14px 16px calc(32px + env(safe-area-inset-bottom)); background: #fff; }

.report-privacy {
  display: flex;
  align-items: flex-start;
  padding: 12px;
  border-radius: 12px;
  background: #f7f9f9;
  color: #536471;
  font-size: 12px;
  line-height: 18px;
}
.report-privacy image { flex: none; width: 16px; height: 16px; margin: 1px 8px 0 0; filter: grayscale(1); opacity: 0.75; }

.report-target {
  display: flex;
  gap: 10px;
  margin: 12px 0 16px;
  padding: 10px 12px;
  border-radius: 12px;
  background: #f7f9f9;
  color: #536471;
  font-size: 13px;
}
.report-target text:last-child { flex: 1; overflow: hidden; color: #0f1419; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }

.report-section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 18px 0 8px;
  font-size: 13px;
  font-weight: 700;
  color: #536471;
}
.report-section-title text:last-child { color: #536471; font-size: 12px; font-weight: 400; }
.report-required { color: #f4212e; }

.report-reasons { display: flex; flex-direction: column; border-top: 1px solid #eff3f4; border-bottom: 1px solid #eff3f4; }
.report-reason {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 48px;
  padding: 0 2px;
  border-bottom: 1px solid #eff3f4;
  border-radius: 0;
  background: #fff;
  color: #0f1419;
  font-size: 15px;
  text-align: left;
  box-sizing: border-box;
}
.report-reason:last-child { border-bottom: 0; }
.report-reason--selected { font-weight: 700; }
.report-reason:active { background: #f7f9f9; }
.report-reason radio { transform: scale(0.85); transform-origin: right center; }

.report-detail-box {
  position: relative;
  min-height: 108px;
  padding: 12px 14px 28px;
  border-radius: 16px;
  background: #f7f9f9;
  border: 1px solid #eff3f4;
}
.report-detail-box textarea { width: 100%; min-height: 76px; color: #0f1419; font-size: 15px; line-height: 21px; }
.report-detail-box > text { position: absolute; right: 12px; bottom: 8px; color: #536471; font-size: 12px; font-variant-numeric: tabular-nums; }

.report-evidence { display: flex; flex-wrap: wrap; gap: 10px; padding: 6px 0; }
.report-evidence-image, .report-evidence-add {
  position: relative;
  width: 72px;
  height: 72px;
  overflow: hidden;
  border-radius: 14px;
}
.report-evidence-image image { width: 100%; height: 100%; }
.report-evidence-image button {
  position: absolute;
  top: 4px;
  right: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  min-width: 22px;
  height: 22px;
  padding: 0;
  border-radius: 50%;
  background: rgba(15, 20, 25, 0.72);
}
.report-evidence-image button image { width: 12px; height: 12px; filter: brightness(0) invert(1); }
.report-evidence-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f7f9f9;
  border: 1px dashed #cfd9de;
  color: #536471;
  font-size: 11px;
  box-sizing: border-box;
}
.report-evidence-add image { width: 20px; height: 20px; margin-bottom: 4px; filter: grayscale(1); opacity: 0.75; }

.report-local-note { margin: 16px 0 12px; color: #536471; font-size: 12px; text-align: center; }
.report-page .report-submit {
  width: 100%;
  height: 44px;
  line-height: 44px;
  border-radius: 22px;
  background: #0f1419;
  color: #fff;
  font-size: 15px;
  font-weight: 700;
}
.report-page .report-submit[disabled] { opacity: 0.5; }
.report-unavailable { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 96px 24px; color: #536471; font-size: 14px; }

@media (min-width: 500px) {
  .report-page { max-width: 460px; margin: 0 auto; }
}
