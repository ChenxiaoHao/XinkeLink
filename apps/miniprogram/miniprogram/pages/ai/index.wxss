/* Link AI：AI 消息不用气泡（紫色 ✦ + 正文），用户消息右对齐蓝色气泡。
   数值口径 375 基准 px；页面靠 app.wxss 的 460 窄栏兜住平板。 */
.ai-header { position:sticky; top:0; z-index:20; background:#fff; }
/* 底部固定区 = 推荐提问 + 输入行，正文要留出等比空白，否则最后一条会被盖住。 */
.ai-page { padding:8px 16px calc(196px + env(safe-area-inset-bottom)); background:#fff; }

.ai-row { display:flex; align-items:flex-start; gap:8px; margin-bottom:20px; }
.ai-row--me { justify-content:flex-end; }
/* 空会话欢迎区：居中放在页面上部，消除大面积空白。 */
.ai-hero { display:flex; flex-direction:column; align-items:center; padding:110px 40px 0; text-align:center; }
.ai-hero-icon { width:44px; height:44px; }
.ai-hero-title { margin-top:12px; font-size:23px; font-weight:800; color:#0f1419; }
.ai-hero-sub { margin-top:6px; font-size:15px; line-height:20px; color:#536471; }
.ai-avatar { flex:none; display:flex; align-items:center; justify-content:center; width:32px; height:32px; margin-top:1px; border-radius:16px; background:#0f1419; }
.ai-avatar image { width:18px; height:18px; }
.ai-bubble { min-width:0; max-width:100%; }
.ai-bubble--ai { flex:1; }
.ai-bubble--me { max-width:78%; padding:10px 14px; border-radius:18px; background:#0f1419; }
.ai-text { display:block; color:#0f1419; font-size:15px; line-height:22px; white-space:pre-wrap; word-break:break-word; overflow-wrap:anywhere; }
.ai-bubble--me .ai-text { color:#fff; }

.ai-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
.ai-action { box-sizing:border-box; min-width:0; width:auto; height:34px; margin:0; padding:0 16px; border:1px solid #cfd9de; border-radius:17px; background:#fff; color:#0f1419; font-size:15px; font-weight:700; line-height:32px; }
.ai-action:active { background:#f7f9f9; }
.ai-bottom { height:1px; }

.ai-suggest { padding:0 0 10px; }
.ai-suggest-title { display:block; margin-bottom:10px; color:#536471; font-size:13px; line-height:18px; }
.ai-suggest-list { display:flex; flex-wrap:wrap; gap:8px; }
.ai-suggest-chip { box-sizing:border-box; min-width:0; width:auto; height:34px; margin:0; padding:0 16px; border:1px solid #cfd9de; border-radius:17px; background:#fff; color:#0f1419; font-size:15px; font-weight:400; line-height:32px; }
.ai-suggest-chip:active { background:#f7f9f9; }

.ai-compose { position:fixed; left:0; right:0; z-index:30; display:flex; flex-direction:column; padding:10px 16px; background:#fff; border-top:1px solid #eff3f4; }
.ai-input-row { display:flex; align-items:flex-end; gap:8px; }
.ai-input { flex:1; width:0; min-height:40px; max-height:120px; box-sizing:border-box; padding:10px 16px; border-radius:20px; background:#eff3f4; color:#0f1419; font-size:15px; line-height:20px; }
.ai-send { flex:none; display:flex; align-items:center; justify-content:center; width:36px; min-width:36px; max-width:36px; height:36px; margin:0 0 2px; padding:0; border-radius:18px; background:#0f1419; }
.ai-send image { width:20px; height:20px; }
/* 空输入时按钮仍然可见（设计稿就是一颗常亮的蓝色圆），点击由 onSend 内部判空拦截。 */
.ai-send--idle { opacity:.55; }

@media (min-width: 500px) {
  .ai-page, .ai-compose { max-width:460px; margin:0 auto; }
}
