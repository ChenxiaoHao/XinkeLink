<app-shell id="app-shell">
<view class="ai-header"><page-header left title="Link AI" badge="免费" action="plus" bind:action="onNewChat" /></view>
<view class="ai-page">
  <view class="ai-thread">
    <!-- 空会话：居中欢迎区（对齐 X Grok 的空态），开聊后恢复消息流。 -->
    <view wx:if="{{messages.length === 1}}" class="ai-hero">
      <image class="ai-hero-icon" src="/assets/icons/x-sparkle-ink.png" mode="aspectFit" />
      <text class="ai-hero-title">你好，我是 Link AI</text>
      <text class="ai-hero-sub">帮你润色文案、出主意、答疑，完全免费。</text>
    </view>
    <block wx:if="{{messages.length > 1}}">
      <view wx:for="{{messages}}" wx:key="id" class="ai-row ai-row--{{item.role}}">
        <view wx:if="{{item.role === 'ai'}}" class="ai-avatar"><image src="/assets/icons/x-sparkle-white.png" mode="aspectFit" /></view>
        <view class="ai-bubble ai-bubble--{{item.role}}">
          <text class="ai-text" user-select>{{item.text}}</text>
          <view wx:if="{{item.actions}}" class="ai-actions">
            <button class="ai-action" data-text="{{item.text}}" bindtap="onCopy">复制</button>
            <button class="ai-action" data-text="{{item.text}}" bindtap="onPostTap">直接发帖</button>
          </view>
        </view>
      </view>
    </block>
    <view id="ai-bottom" class="ai-bottom"></view>
  </view>
</view>
</app-shell>
<!-- 底部输入区留在 app-shell 外：外壳的 transform 会吃掉 position:fixed 的定位基准。 -->
<view class="ai-compose" style="bottom:{{keyboardHeight ? keyboardHeight + 'px' : 'calc(53px + env(safe-area-inset-bottom))'}};">
  <!-- 推荐提问贴着输入框：设计稿里它固定在输入框正上方，不随会话滚走。 -->
  <view class="ai-suggest">
    <text class="ai-suggest-title">试试这样问</text>
    <view class="ai-suggest-list">
      <button wx:for="{{suggestions}}" wx:key="*this" class="ai-suggest-chip" data-prompt="{{item}}" bindtap="onSuggestion">{{item}}</button>
    </view>
  </view>
  <view class="ai-input-row">
    <textarea class="ai-input" value="{{prompt}}" maxlength="2000" placeholder="问问 Link AI…" auto-height adjust-position="{{false}}" cursor-spacing="16" bindinput="onInput" bindkeyboardheightchange="onKeyboardHeightChange" />
    <button class="ai-send {{prompt ? '' : 'ai-send--idle'}}" bindtap="onSend" aria-label="发送"><image src="/assets/icons/arrow-up-white.png" mode="aspectFit" /></button>
  </view>
</view>
<profile-auth-sheet visible="{{authVisible}}" busy="{{authSaving}}" error="{{authError}}" bind:confirm="onProfileAuthConfirm" bind:cancel="onProfileAuthCancel" />
