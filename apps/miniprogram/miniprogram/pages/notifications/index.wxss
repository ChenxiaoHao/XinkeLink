/* 通知：全部 / 未读 两栏 + 类型图标 + 头像 + 三段式文案，行间不用分割线。
   数值口径 375 基准 px。 */
.notification-header { position:sticky; top:0; z-index:20; background:#fff; }

.notification-tabs { display:flex; height:48px; border-bottom:1px solid #eff3f4; }
.notification-tab { display:flex; align-items:center; justify-content:center; flex:1; width:0; min-width:0; margin:0; padding:0; border-radius:0; background:#fff; color:#536471; font-size:15px; font-weight:500; }
.notification-tab > view { position:relative; display:flex; align-items:center; justify-content:center; gap:8px; height:48px; padding:0 16px; }
.notification-tab-icon { width:20px; height:20px; }
.notification-tab-underline { position:absolute; left:16px; right:16px; bottom:0; height:4px; border-radius:2px; background:transparent; }
.notification-tab--active { color:#0f1419; font-weight:700; }
.notification-tab--active .notification-tab-underline { background:#0f1419; }

.notification-list { padding-bottom:calc(88px + env(safe-area-inset-bottom)); }
.notification-row { display:flex; align-items:flex-start; gap:10px; padding:14px 16px; background:#fff; border-bottom:1px solid #eff3f4; }
.notification-row:active { background:#f7f9f9; }
.notification-symbol { flex:none; width:18px; height:18px; margin-top:9px; }
.notification-avatar { flex:none; box-sizing:border-box; width:38px; height:38px; border-radius:50%; border:0.5px solid rgba(15,20,25,0.08); background:#eff3f4; }
/* 平台公告用品牌字母圆（深黑底白字）。 */
.notification-avatar--brand { display:flex; align-items:center; justify-content:center; background:#0f1419; color:#fff; font-size:15px; font-weight:700; line-height:1; border:0; }
.notification-content { flex:1; min-width:0; }
.notification-line { display:flex; align-items:baseline; gap:4px; }
.notification-actor { flex:none; max-width:50%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#0f1419; font-size:14px; font-weight:700; line-height:20px; }
.notification-summary { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#536471; font-size:14px; line-height:20px; }
.notification-time { flex:none; margin-left:4px; color:#536471; font-size:12px; line-height:18px; }
.notification-quote { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin-top:3px; color:#536471; font-size:14px; line-height:20px; }
.notification-cover { flex:none; box-sizing:border-box; width:46px; height:46px; margin-top:0; border:0.5px solid rgba(15,20,25,0.08); border-radius:10px; background:#eff3f4; }

.notification-empty { padding:72px 32px; text-align:center; }
.notification-empty-icon { width:52px; height:52px; margin:0 auto 16px; }
.notification-empty-title { display:block; color:#0f1419; font-size:21px; font-weight:800; line-height:28px; }
.notification-empty-copy { display:block; margin-top:8px; color:#536471; font-size:14px; line-height:21px; }
.notification-empty-action { width:max-content; min-width:0; margin:22px auto 0 !important; padding:0 28px; height:42px; border-radius:21px; background:#0f1419; color:#fff; font-size:15px; font-weight:700; line-height:42px; }

@media (min-width: 500px) {
  .notification-list { padding-bottom:calc(88px + env(safe-area-inset-bottom)); }
}
