/* 我的帖子：与首页同一条列表节奏（满宽行 + 1px 分割），只在下方挂「编辑 / 删除」。
   数值口径 375 基准 px。 */
.record-page { min-height:100vh; padding-bottom:calc(32px + env(safe-area-inset-bottom)); background:#fff; }

.record-intro { padding:12px 16px; border-bottom:1px solid #eff3f4; color:#536471; font-size:13px; line-height:18px; }
.own-post { border-bottom:1px solid #eff3f4; }
.own-post-actions { display:flex; align-items:center; gap:16px; padding:0 16px 12px 64px; }
.own-post-note { flex:1; min-width:0; color:#536471; font-size:13px; line-height:18px; }
.own-post-action { min-width:0; width:auto; margin:0; padding:0; background:transparent; color:#0f1419; font-size:13px; font-weight:700; line-height:18px; }
.own-post-action--danger { color:#f4212e; }
.own-post-action[disabled] { opacity:.5; }

.record-end { padding:24px 16px; text-align:center; color:#536471; font-size:13px; }

.record-empty { padding:48px 32px; text-align:center; }
.record-empty-title { display:block; color:#0f1419; font-size:20px; font-weight:800; line-height:26px; }
.record-empty-copy { display:block; margin-top:8px; color:#536471; font-size:15px; line-height:20px; }
.record-primary { width:max-content; min-width:0; margin:20px auto 0 !important; padding:0 20px; height:36px; border-radius:18px; background:#0f1419; color:#fff; font-size:15px; font-weight:700; line-height:36px; }

@media (min-width: 500px) {
  .record-page { max-width:460px; margin:0 auto; }
}
