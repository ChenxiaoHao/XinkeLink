<view class="compose-header" style="padding-top:{{statusHeight}}px;">
  <view class="compose-header-bar" style="padding-right:{{rightSpace + 8}}px;">
    <button class="compose-cancel" bindtap="onCancelTap" disabled="{{publishing}}">取消</button>
    <button class="compose-publish {{form.content.length && !publishing ? '' : 'compose-publish--idle'}}" bindtap="onPublishTap" loading="{{publishing}}">{{editId ? '保存' : '发布'}}</button>
  </view>
</view>

<view class="compose-page">
  <view wx:if="{{loadFailed}}" class="compose-failed">
    <text>帖子暂时无法读取</text>
    <button bindtap="onCancelTap">返回</button>
  </view>
  <block wx:else>
    <view class="compose-author">
      <image class="compose-avatar" src="{{selfAvatar}}" mode="aspectFill" />
      <textarea class="compose-content" value="{{form.content}}" placeholder="有什么新鲜事？" maxlength="500" auto-height adjust-position="{{true}}" cursor-spacing="24" bindinput="onContentInput" bindkeyboardheightchange="onKeyboardHeightChange" disabled="{{publishing}}" />
    </view>
    <view wx:if="{{form.images.length}}" class="compose-photos compose-photos--{{form.images.length === 1 ? 'single' : 'grid'}}">
      <view wx:for="{{form.images}}" wx:key="index" class="compose-photo" data-index="{{index}}" bindtap="onPreviewImage">
        <image src="{{item}}" mode="aspectFill" />
        <button class="compose-photo-remove" data-index="{{index}}" catchtap="onRemoveImage" aria-label="删除第{{index + 1}}张图片"><image src="/assets/icons/x-x-white.png" /></button>
      </view>
    </view>
  </block>
</view>

<!-- 直接展示当前标签与身份；编辑时身份保持原帖子设置。 -->
<view class="compose-bottom" style="bottom:{{keyboardHeight}}px; padding-bottom:{{keyboardHeight ? '8px' : 'calc(8px + env(safe-area-inset-bottom))'}};">
  <view class="compose-options">
    <picker class="compose-category-picker" range="{{categories}}" range-key="label" value="{{categoryIndex}}" disabled="{{publishing || loadFailed}}" bindchange="onCategoryPickerChange">
      <view class="compose-option" aria-label="当前标签：{{categoryLabel}}，点击切换"><image class="compose-option-icon" src="/assets/icons/x-hash-ink.png" /><text class="compose-category-label">{{categoryLabel}}</text><image class="compose-option-chevron" src="/assets/icons/x-chevron-down-ink.png" /></view>
    </picker>
    <button class="compose-option compose-identity" bindtap="onAnonymousTap" disabled="{{publishing || loadFailed || editId}}" aria-label="{{editId ? '编辑时不能改变发布身份' : form.anonymous ? '当前匿名发布，点击切换为本人发布' : '当前本人发布，点击切换为匿名发布'}}"><image class="compose-option-icon" src="/assets/icons/x-user-round-ink.png" /><text class="compose-identity-label">{{form.anonymous ? '匿名发布' : '以 ' + (selfNickname || '本人') + ' 发布'}}</text><image wx:if="{{!editId}}" class="compose-option-chevron" src="/assets/icons/x-chevron-down-ink.png" /></button>
  </view>
  <view class="compose-toolbar">
    <button class="compose-tool" bindtap="onAddImages" disabled="{{publishing}}" aria-label="添加图片"><image src="/assets/icons/x-image-ink.png" /></button>
    <text class="compose-count">{{form.content.length}}/500</text>
  </view>
</view>
<profile-auth-sheet visible="{{authVisible}}" busy="{{authSaving}}" error="{{authError}}" bind:confirm="onProfileAuthConfirm" bind:cancel="onProfileAuthCancel" />
