/* 撰写页对齐 X compose：顶栏只有「取消」，「发布」独立一行放在胶囊下方；
   正文 20px；底部 = 回复范围行 + 工具条。数值口径 375 基准 px。 */
.compose-header { position:sticky; top:0; z-index:20; background:#fff; }
/* 整行（取消 + 发布）放在胶囊下方，一行排开，不再分两行。 */
.compose-header-bar { display:flex; align-items:center; justify-content:space-between; height:44px; padding:0 16px; }
.compose-cancel { min-width:0; margin:0; padding:0; background:transparent; color:#0f1419; font-size:15px; font-weight:500; line-height:20px; }
.compose-publish { flex:none; min-width:64px; height:34px; margin:0 !important; padding:0 18px; border-radius:17px; background:#0f1419; color:#fff; font-size:15px; font-weight:700; line-height:34px; }
/* 空内容时按钮半透明（不用 disabled，微信的 disabled 样式会吃掉蓝底）。 */
.compose-publish--idle { opacity:.5; }

.compose-page { padding:0 16px calc(120px + env(safe-area-inset-bottom)); background:#fff; }
.compose-author { display:flex; align-items:flex-start; gap:12px; padding:8px 0 12px; }
.compose-avatar { flex:none; width:40px; height:40px; margin-top:2px; border-radius:50%; background:#eff3f4; }
.compose-content { flex:1; width:0; min-height:96px; padding:6px 0 0; color:#0f1419; font-size:20px; line-height:28px; }

.compose-photos { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 12px 52px; }
.compose-photo { position:relative; width:calc((100% - 16px) / 3); overflow:hidden; border:1px solid #cfd9de; border-radius:12px; background:#eff3f4; }
.compose-photo::before { content:''; display:block; padding-top:100%; }
.compose-photo > image { position:absolute; inset:0; width:100%; height:100%; }
.compose-photos--single .compose-photo { width:100%; }
.compose-photos--single .compose-photo::before { padding-top:66%; }
.compose-photo-remove { position:absolute; top:8px; right:8px; display:flex; align-items:center; justify-content:center; width:26px; height:26px; margin:0; padding:0; border-radius:13px; background:rgba(15,20,25,.72); }
.compose-photo-remove image { position:static; width:14px; height:14px; }

.compose-failed { padding:64px 16px; text-align:center; color:#536471; font-size:15px; }
.compose-failed button { width:max-content; min-width:0; margin:20px auto 0 !important; padding:0 20px; height:36px; border-radius:18px; background:#0f1419; color:#fff; font-size:15px; font-weight:700; line-height:36px; }

/* 底部固定区：上面一行是回复范围（点按可切匿名），下面一行是工具条 + 字数。 */
.compose-bottom { position:fixed; left:0; right:0; z-index:30; background:#fff; border-top:1px solid #eff3f4; }
.compose-scope { display:flex; align-items:center; gap:8px; width:100%; min-width:0; height:40px; padding:0 16px; margin:0; background:transparent; border-radius:0; }
.compose-scope image { width:16px; height:16px; flex:none; opacity:.75; }
.compose-scope text { color:#536471; font-size:15px; line-height:20px; }
.compose-toolbar { display:flex; align-items:center; gap:8px; padding:8px 12px; }
.compose-tool { display:flex; align-items:center; justify-content:center; width:40px; height:40px; margin:0; padding:0; border-radius:20px; background:transparent; }
.compose-tool image { width:22px; height:22px; }
.compose-tool:active, .compose-tool--on { background:#eff3f4; }
.compose-tool-picker { flex:none; }
.compose-count { margin-left:auto; padding-right:4px; color:#536471; font-size:13px; line-height:18px; font-variant-numeric:tabular-nums; }

@media (min-width: 500px) {
  .compose-page, .compose-bottom { max-width:460px; margin:0 auto; }
}
