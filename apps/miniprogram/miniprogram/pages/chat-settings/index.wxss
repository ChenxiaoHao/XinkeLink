page {
  background: #ffffff;
  color: #0f1419;
  --profile-auth-primary: #0f1419;
}
.chat-settings-page { padding: 0 0 calc(32px + env(safe-area-inset-bottom)); background: #fff; }
.chat-settings-peer {
  display: flex;
  align-items: center;
  padding: 16px;
  background: #fff;
  border-bottom: 8px solid #f7f9f9;
}
.chat-settings-peer > image:first-child {
  flex: none;
  box-sizing: border-box;
  width: 48px;
  height: 48px;
  margin-right: 12px;
  border-radius: 50%;
  border: 0.5px solid rgba(15, 20, 25, 0.08);
  background: #eff3f4;
}
.chat-settings-peer-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 2px; }
.chat-settings-peer-copy text:first-child { font-size: 16px; font-weight: 700; color: #0f1419; }
.chat-settings-peer-copy text:nth-child(2) { overflow: hidden; color: #536471; font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
.chat-settings-peer-copy text:nth-child(3) { color: #536471; font-size: 12px; }
.chat-settings-chevron { width: 16px; height: 16px; flex: none; margin-left: 8px; opacity: 0.6; }

.chat-settings-section {
  display: block;
  padding: 14px 16px 6px;
  color: #536471;
  font-size: 12px;
  font-weight: 600;
}
.chat-settings-card { padding: 0 16px; background: #fff; border-bottom: 8px solid #f7f9f9; }
.chat-setting-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 54px;
  padding: 10px 0;
  border-bottom: 1px solid #eff3f4;
  background: #fff;
  text-align: left;
  box-sizing: border-box;
}
.chat-setting-row:last-child { border-bottom: 0; }
.chat-setting-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  flex: none;
  margin-right: 12px;
  background: transparent;
}
.chat-setting-icon image { width: 19px; height: 19px; filter: grayscale(1); }
.chat-setting-label { flex: 1; min-width: 0; color: #0f1419; font-size: 15px; font-weight: 500; }
.chat-setting-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 2px; }
.chat-setting-copy > text:first-child { color: #0f1419; font-size: 15px; font-weight: 500; }
.chat-setting-copy > text:last-child, .chat-setting-note { color: #536471; font-size: 12px; }
.chat-setting-row switch { flex: none; transform: scale(0.84); transform-origin: right center; }

.chat-history-search { padding: 10px 0 14px; border-bottom: 1px solid #eff3f4; }
.chat-history-input {
  display: flex;
  align-items: center;
  height: 36px;
  padding: 0 12px;
  border-radius: 18px;
  background: #eff3f4;
}
.chat-history-input image { width: 15px; height: 15px; margin-right: 8px; opacity: 0.7; }
.chat-history-input input { flex: 1; min-width: 0; font-size: 14px; color: #0f1419; }
.chat-history-empty { padding: 12px 0; color: #536471; font-size: 13px; }
.chat-history-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 10px 0;
  background: #fff;
  color: #0f1419;
  font-size: 14px;
  text-align: left;
}
.chat-history-result text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.chat-settings-tip {
  display: flex;
  align-items: flex-start;
  margin: 16px 16px 0;
  padding: 12px;
  border-radius: 12px;
  background: #f7f9f9;
  color: #536471;
  font-size: 12px;
  line-height: 18px;
}
.chat-settings-tip image { width: 15px; height: 15px; flex: none; margin: 2px 8px 0 0; filter: grayscale(1); opacity: 0.7; }
.chat-settings-local { display: block; margin-top: 12px; color: #536471; font-size: 12px; text-align: center; }

.chat-settings-state { display: flex; flex-direction: column; align-items: center; padding: 96px 24px; color: #536471; font-size: 14px; }
.chat-settings-state button {
  margin-top: 16px !important;
  padding: 0 22px;
  height: 38px;
  line-height: 38px;
  border-radius: 19px;
  background: #0f1419;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
}

@media (min-width: 500px) {
  .chat-settings-page { max-width: 460px; margin: 0 auto; }
}
