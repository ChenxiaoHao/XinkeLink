.chat-settings-page { padding: 18rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.chat-settings-peer { display: flex; align-items: center; margin-bottom: 22rpx; padding: 20rpx; border-radius: 18rpx; background: #FFF; box-shadow: var(--xlk-shadow-card); }
.chat-settings-peer > image:first-child { flex: none; width: 100rpx; height: 100rpx; margin-right: 16rpx; border-radius: 50%; }
.chat-settings-peer-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.chat-settings-peer-copy text:first-child { font-size: 27rpx; font-weight: 600; }
.chat-settings-peer-copy text:nth-child(2) { overflow: hidden; color: #778499; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.chat-settings-peer-copy text:nth-child(3) { color: #8B96A6; font-size: 24rpx; }
.chat-settings-chevron { width: 26rpx; height: 26rpx; flex: none; margin-left: 8rpx; }
.chat-settings-section { display: block; margin: 20rpx 6rpx 10rpx; color: #768398; font-size: 24rpx; }
.chat-settings-card { overflow: hidden; padding: 0 18rpx; border-radius: 18rpx; background: #FFF; box-shadow: var(--xlk-shadow-card); }
.chat-setting-row { display: flex; align-items: center; width: 100%; min-height: 92rpx; padding: 12rpx 4rpx; border-bottom: 1rpx solid #EFF1F5; background: #FFF; text-align: left; }
.chat-setting-row:last-child { border-bottom: 0; }
.chat-setting-icon { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; flex: none; margin-right: 14rpx; border-radius: 50%; background: #EEF2FA; }
.chat-setting-icon image { width: 28rpx; height: 28rpx; }
.chat-setting-icon--danger { background: #F8EEEE; }
.chat-setting-label { flex: 1; min-width: 0; color: #344155; font-size: 24rpx; }
.chat-setting-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.chat-setting-copy > text:last-child,.chat-setting-note { color: #8893A3; font-size: 24rpx; }
.chat-setting-row switch { flex: none; transform: scale(.83); transform-origin: right center; }
.chat-setting-button::after { border: 0; }
.chat-history-search { padding: 12rpx 0 14rpx 64rpx; border-bottom: 1rpx solid #EFF1F5; }
.chat-history-input { display: flex; align-items: center; height: 58rpx; padding: 0 14rpx; border-radius: 30rpx; background: #EEF1F8; }
.chat-history-input image { width: 25rpx; height: 25rpx; margin-right: 10rpx; }
.chat-history-input input { flex: 1; min-width: 0; font-size: 24rpx; }
.chat-history-empty { padding: 16rpx 0; color: #8994A4; font-size: 24rpx; }
.chat-history-result { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 12rpx 0; background: #FFF; color: #5B6980; font-size: 24rpx; text-align: left; }
.chat-history-result text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chat-settings-tip { display: flex; align-items: flex-start; margin-top: 22rpx; padding: 18rpx; border-radius: 16rpx; background: #EEF3FC; color: #71809A; font-size: 24rpx; line-height: 1.5; }
.chat-settings-tip image { width: 28rpx; height: 28rpx; flex: none; margin: 2rpx 10rpx 0 0; }
.chat-settings-local { display: block; margin-top: 16rpx; color: #949EAD; font-size: 24rpx; text-align: center; }
.chat-settings-state { display: flex; flex-direction: column; align-items: center; padding: 180rpx 30rpx; color: #8792A3; }
.chat-settings-state button { margin-top: 20rpx; background: var(--xlk-color-primary-strong); color: #FFF; }
.chat-setting-icon { background: transparent; }
.chat-settings-local { color: #667085; font-size: 24rpx; }

@import "../../styles/page-polish.wxss";

/* 已确认的二级页面主题，仅作用于当前页面。 */
page { background: #FFFFFF; color: #0F1419; --xlk-color-primary: #222223; --xlk-color-primary-strong: #222223; --xlk-color-primary-soft: #F0F0F3; --xlk-color-background: #FFFFFF; --xlk-color-text: #0F1419; --xlk-color-muted: #536471; --xlk-color-border: #ECECF1; --xlk-shadow-button: none; }

/* tablet-scale:begin */
@media (min-width: 500px) {.chat-settings-page { padding: 9px 14px calc(20px + env(safe-area-inset-bottom)); }
.chat-settings-peer { margin-bottom: 11px; padding: 10px; border-radius: 9px; }
.chat-settings-peer > image:first-child { width: 50px; height: 50px; margin-right: 8px; border-radius: 50%; }
.chat-settings-peer-copy text:first-child { font-size: 13.5px; }
.chat-settings-peer-copy text:nth-child(2) { font-size: 12px; }
.chat-settings-peer-copy text:nth-child(3) { font-size: 12px; }
.chat-settings-chevron { width: 13px; height: 13px; margin-left: 4px; }
.chat-settings-section { margin: 10px 3px 5px; font-size: 12px; }
.chat-settings-card { padding: 0 9px; border-radius: 9px; }
.chat-setting-row { width: 100%; min-height: 46px; padding: 6px 2px; border-bottom: 0.5px solid #EFF1F5; }
.chat-setting-row:last-child { border-bottom: 0; }
.chat-setting-icon { width: 25px; height: 25px; margin-right: 7px; border-radius: 50%; }
.chat-setting-icon image { width: 14px; height: 14px; }
.chat-setting-label { font-size: 12px; }
.chat-setting-copy > text:last-child,.chat-setting-note { font-size: 12px; }
.chat-history-search { padding: 6px 0 7px 32px; border-bottom: 0.5px solid #EFF1F5; }
.chat-history-input { height: 29px; padding: 0 7px; border-radius: 15px; }
.chat-history-input image { width: 12.5px; height: 12.5px; margin-right: 5px; }
.chat-history-input input { font-size: 12px; }
.chat-history-empty { padding: 8px 0; font-size: 12px; }
.chat-history-result { width: 100%; padding: 6px 0; font-size: 12px; }
.chat-settings-tip { margin-top: 11px; padding: 9px; border-radius: 8px; font-size: 12px; }
.chat-settings-tip image { width: 14px; height: 14px; margin: 1px 5px 0 0; }
.chat-settings-local { margin-top: 8px; font-size: 12px; }
.chat-settings-state { padding: 90px 15px; }
.chat-settings-state button { margin-top: 10px; }
.chat-settings-local { font-size: 12px; }
}

/* tablet-scale:end */
