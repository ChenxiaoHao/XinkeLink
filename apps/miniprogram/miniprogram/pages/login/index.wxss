.login-page { padding: 28rpx 34rpx calc(44rpx + env(safe-area-inset-bottom)); }
.login-brand { display: flex; flex-direction: column; align-items: center; padding: 0 0 35rpx; }
.login-logo { display: flex; align-items: center; justify-content: center; width: 126rpx; height: 126rpx; border-radius: 50%; background: #EDF2FC; }
.login-logo image { width: 88rpx; height: 88rpx; }
.login-title { margin-top: 18rpx; font-size: 39rpx; font-weight: 600; color: var(--xlk-color-text); }
.login-tagline { margin-top: 4rpx; font-size: 27rpx; color: var(--xlk-color-primary-strong); }
.login-badge { margin-top: 16rpx; padding: 4rpx 18rpx; border-radius: 24rpx; background: #EAF0FB; font-size: 20rpx; color: var(--xlk-color-primary-strong); }
.login-story { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; padding: 20rpx; border-radius: 24rpx; background: #EEF3FD; }
.login-story > image { width: 106rpx; height: 106rpx; flex-shrink: 0; border-radius: 14rpx; }
.login-story > view { flex: 1; }
.login-story text, .login-feature text { display: block; font-size: 26rpx; color: var(--xlk-color-text); }
.login-story text + text, .login-feature text + text { margin-top: 6rpx; color: var(--xlk-color-muted); font-size: 22rpx; line-height: 1.8; }
.login-feature { display: flex; align-items: flex-start; gap: 18rpx; padding: 24rpx 20rpx; margin-bottom: 18rpx; background: #FFF; border-radius: 24rpx; box-shadow: var(--xlk-shadow-card); }
.login-feature-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 60rpx; height: 60rpx; border-radius: 50%; background: var(--xlk-color-primary-soft); }
.login-feature-icon image { width: 29rpx; height: 29rpx; }
.login-simulation { padding: 22rpx; margin: 26rpx 0 34rpx; border-radius: 22rpx; background: #EEF3FD; }
.login-simulation > view { display: flex; align-items: center; gap: 10rpx; margin-bottom: 10rpx; color: var(--xlk-color-primary-strong); font-size: 25rpx; font-weight: 600; }
.login-simulation image { width: 28rpx; height: 28rpx; }
.login-simulation > text { color: var(--xlk-color-primary-strong); font-size: 22rpx; line-height: 1.8; }
.login-page .login-primary, .login-page .login-guest { display: block; box-sizing: border-box; width: 100%; min-width: 0; padding: 20rpx; margin: 0; border-radius: 50rpx; line-height: 1.6; font-size: 26rpx; font-weight: 400; }
.login-page .login-primary { background: var(--xlk-color-primary-strong); color: #FFF; font-weight: 600; box-shadow: var(--xlk-shadow-button); }
.login-page .login-primary[disabled] { background: var(--xlk-color-primary); color: #FFF; opacity: .7; }
.login-page .login-guest { margin-top: 20rpx; background: #EAF0FB; color: var(--xlk-color-primary-strong); }
.login-footer { display: block; margin-top: 36rpx; color: var(--xlk-color-muted); font-size: 20rpx; text-align: center; }
.login-error { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 18rpx; margin-bottom: 20rpx; background: #FFF; border-radius: 16rpx; font-size: 23rpx; color: var(--xlk-color-muted); }
.login-page .login-error button { box-sizing: border-box; width: auto; min-width: 0; max-width: 100%; flex-shrink: 0; margin: 0; padding: 8rpx 20rpx; background: var(--xlk-color-primary-soft); color: var(--xlk-color-primary-strong); font-size: 21rpx; font-weight: 400; line-height: 1.6; border-radius: 30rpx; }

/* tablet-scale:begin */
@media (min-width: 500px) {.login-page { padding: 14px 17px calc(22px + env(safe-area-inset-bottom)); }
.login-brand { padding: 0 0 17.5px; }
.login-logo { width: 63px; height: 63px; border-radius: 50%; }
.login-logo image { width: 44px; height: 44px; }
.login-title { margin-top: 9px; font-size: 19.5px; }
.login-tagline { margin-top: 2px; font-size: 13.5px; }
.login-badge { margin-top: 8px; padding: 2px 9px; border-radius: 12px; font-size: 10px; }
.login-story { gap: 10px; margin-bottom: 10px; padding: 10px; border-radius: 12px; }
.login-story > image { width: 53px; height: 53px; border-radius: 7px; }
.login-story text, .login-feature text { font-size: 13px; }
.login-story text + text, .login-feature text + text { margin-top: 3px; font-size: 11px; }
.login-feature { gap: 9px; padding: 12px 10px; margin-bottom: 9px; border-radius: 12px; }
.login-feature-icon { width: 30px; height: 30px; border-radius: 50%; }
.login-feature-icon image { width: 14.5px; height: 14.5px; }
.login-simulation { padding: 11px; margin: 13px 0 17px; border-radius: 11px; }
.login-simulation > view { gap: 5px; margin-bottom: 5px; font-size: 12.5px; }
.login-simulation image { width: 14px; height: 14px; }
.login-simulation > text { font-size: 11px; }
.login-page .login-primary, .login-page .login-guest { width: 100%; padding: 10px; margin: 0; border-radius: 25px; font-size: 13px; }
.login-page .login-guest { margin-top: 10px; }
.login-footer { margin-top: 18px; font-size: 10px; }
.login-error { gap: 6px; padding: 9px; margin-bottom: 10px; border-radius: 8px; font-size: 11.5px; }
.login-page .login-error button { width: auto; margin: 0; padding: 4px 10px; font-size: 10.5px; border-radius: 15px; }
}

/* tablet-scale:end */
