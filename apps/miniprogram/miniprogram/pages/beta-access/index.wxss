page {
  background: #F7F7F7;
  --profile-auth-overlay: rgba(0, 0, 0, 0);
  --profile-auth-overlay-open: rgba(0, 0, 0, .28);
  --profile-auth-text: #111111;
  --profile-auth-muted: #666666;
  --profile-auth-handle: #DDDDDD;
  --profile-auth-border: #E5E5E5;
  --profile-auth-primary: #111111;
  --profile-auth-avatar-background: #F7F7F7;
  --profile-auth-error: #222222;
  --profile-auth-brand-filter: grayscale(1) brightness(0);
  --profile-auth-icon-filter: grayscale(1);
}
.beta-page { padding: 64rpx 40rpx 48rpx; color: #111111; }
.beta-brand { display: flex; align-items: center; gap: 20rpx; margin-bottom: 64rpx; font-size: 32rpx; font-weight: 600; }
.beta-brand image { width: 76rpx; height: 76rpx; filter: grayscale(1) brightness(0); }
.beta-form { padding: 40rpx 32rpx; background: #FFFFFF; border-radius: 24rpx; }
.beta-title { display: block; font-size: 42rpx; line-height: 1.35; font-weight: 600; }
.beta-description, .beta-help { display: block; font-size: 28rpx; line-height: 1.65; color: #666666; }
.beta-description { margin-top: 20rpx; margin-bottom: 48rpx; }
.beta-label { display: block; margin-bottom: 16rpx; font-size: 30rpx; font-weight: 500; }
.beta-help { font-size: 26rpx; }
.beta-input { box-sizing: border-box; height: 100rpx; width: 100%; margin: 16rpx 0 20rpx; padding: 0 24rpx; border: 2rpx solid #BDBDBD; border-radius: 16rpx; font-size: 30rpx; background: #FFFFFF; }
.beta-primary { display: flex; justify-content: center; align-items: center; min-height: 96rpx; margin-top: 36rpx; padding: 20rpx; border-radius: 16rpx; background: #111111; color: #FFFFFF; font-size: 30rpx; line-height: 1.5; font-weight: 500; }
.beta-primary::after { border: 0; }
.beta-primary[disabled] { background: #E3E3E3; color: #666666; }
.beta-state { padding: 24rpx 0; font-size: 28rpx; line-height: 1.6; color: #666666; }
.beta-error { display: block; margin-top: 24rpx; font-size: 26rpx; line-height: 1.6; font-weight: 500; color: #222222; }
.beta-footer { display: block; margin: 32rpx 0; padding: 0 8rpx; font-size: 24rpx; line-height: 1.6; color: #666666; }

/* tablet-scale:begin */
@media (min-width: 500px) {
.beta-page { padding: 32px 20px 24px; }
.beta-brand { gap: 10px; margin-bottom: 32px; font-size: 16px; }
.beta-brand image { width: 38px; height: 38px; }
.beta-form { padding: 20px 16px; border-radius: 12px; }
.beta-title { font-size: 21px; }
.beta-description, .beta-help { font-size: 14px; }
.beta-description { margin-top: 10px; margin-bottom: 24px; }
.beta-label { margin-bottom: 8px; font-size: 15px; }
.beta-help { font-size: 13px; }
.beta-input { height: 50px; width: 100%; margin: 8px 0 10px; padding: 0 12px; border: 1px solid #BDBDBD; border-radius: 8px; font-size: 15px; }
.beta-primary { min-height: 48px; margin-top: 18px; padding: 10px; border-radius: 8px; font-size: 15px; }
.beta-primary::after { border: 0; }
.beta-state { padding: 12px 0; font-size: 14px; }
.beta-error { margin-top: 12px; font-size: 13px; }
.beta-footer { margin: 16px 0; padding: 0 4px; font-size: 12px; }
}

/* tablet-scale:end */
