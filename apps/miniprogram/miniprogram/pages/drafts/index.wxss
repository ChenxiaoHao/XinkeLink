.drafts-page { padding:20px 16px; }.drafts-note { font-size:13px; color:#536471; }.draft-row { text-align:left; border-radius:0; background:#fff; padding:20px 0; border-bottom:1px solid #eff3f4; }.draft-row text { display:block; font-size:15px; line-height:1.5; }.draft-row text:first-child { font-weight:700; margin-bottom:8px; }.drafts-empty { padding:48px 20px; color:#536471; }.drafts-empty text { display:block; font-size:15px; }.drafts-empty text:first-child { font-size:26px; font-weight:800; color:#0f1419; margin-bottom:12px; }