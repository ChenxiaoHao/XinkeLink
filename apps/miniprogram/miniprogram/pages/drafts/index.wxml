<back-header title="草稿" fallback="/pages/forum/index" /><view class="drafts-page"><text class="drafts-note">草稿保存在当前设备</text><view wx:if="{{loadFailed}}" class="drafts-empty">草稿暂时无法读取，请重新进入。</view><block wx:else><button wx:if="{{postDraft}}" class="draft-row" bindtap="onOpenPost"><text>动态草稿</text><text>{{postDraft}}</text></button><view wx:if="{{!postDraft}}" class="drafts-empty"><text>把灵感留到下一次</text><text>发布时保存的草稿会显示在这里。</text></view></block></view>
<profile-auth-sheet visible="{{authVisible}}" busy="{{authSaving}}" error="{{authError}}" bind:confirm="onProfileAuthConfirm" bind:cancel="onProfileAuthCancel" />