.feature { display:flex; flex-direction:column; align-items:center; padding:80px 32px 0; background:#fff; text-align:center; }
.feature-symbol { width:64px; height:64px; display:flex; align-items:center; justify-content:center; }
.feature-symbol image { width:64px; height:64px; opacity:.85; }
.feature-heading { display:flex; align-items:center; gap:8px; margin-top:20px; }
.feature-title { color:#0f1419; font-size:31px; font-weight:800; line-height:36px; }
.feature-badge { padding:2px 8px; border-radius:10px; background:#eff3f4; color:#536471; font-size:12px; font-weight:500; line-height:18px; }
.feature-copy { margin-top:12px; color:#536471; font-size:15px; line-height:22px; }
.feature-note { margin-top:16px; color:#8b98a5; font-size:13px; line-height:18px; }
.feature-back { min-width:0; margin-top:28px; padding:0 24px; height:36px; line-height:36px; border-radius:18px; background:#0f1419; color:#fff; font-size:15px; font-weight:700; }
