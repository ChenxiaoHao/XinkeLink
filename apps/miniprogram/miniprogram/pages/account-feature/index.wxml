<back-header title="{{title}}" fallback="/pages/forum/index" />
<view class="feature">
  <view class="feature-symbol"><image src="/assets/icons/x-info-ink.png" mode="aspectFit" /></view>
  <view class="feature-heading">
    <text class="feature-title">{{title}}</text>
    <text class="feature-badge">建设中</text>
  </view>
  <text class="feature-copy">{{description}}</text>
  <text class="feature-note">信科 Link 目前提供校园动态、评论互动、私信与通知。</text>
  <button class="feature-back" bindtap="onBack">返回</button>
</view>
<profile-auth-sheet visible="{{authVisible}}" busy="{{authSaving}}" error="{{authError}}" bind:confirm="onProfileAuthConfirm" bind:cancel="onProfileAuthCancel" />
