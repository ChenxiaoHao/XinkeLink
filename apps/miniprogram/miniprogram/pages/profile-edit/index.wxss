page {
  background: #ffffff;
  color: #0f1419;
  --profile-auth-primary: #0f1419;
}
.edit-page { padding: 0 0 calc(32px + env(safe-area-inset-bottom)); background: #fff; }
.edit-page .edit-avatar-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  padding: 20px 16px;
  margin: 0;
  background: #fff;
  border-bottom: 1px solid #eff3f4;
  color: #536471;
  font-size: 13px;
  font-weight: 600;
  line-height: 18px;
}
.edit-avatar-wrap { position: relative; margin: 0 0 10px; }
.edit-avatar {
  display: block;
  box-sizing: border-box;
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: 0.5px solid rgba(15, 20, 25, 0.08);
  background: #eff3f4;
}
.edit-camera {
  position: absolute;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border: 2px solid #fff;
  background: #0f1419;
  border-radius: 50%;
}
.edit-camera image { width: 14px; height: 14px; filter: brightness(0) invert(1); }

.edit-card { padding: 0 16px; background: #fff; }
.edit-field {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 52px;
  border-bottom: 1px solid #eff3f4;
}
.edit-field label, .edit-bio label { font-size: 15px; color: #536471; }
.edit-field label { flex-shrink: 0; width: 76px; }
.edit-field input {
  flex: 1;
  min-width: 0;
  width: 0;
  height: 44px;
  text-align: right;
  font-size: 15px;
  color: #0f1419;
}
.edit-field input[disabled] { color: #536471; }
.edit-bio { padding: 14px 0; border-bottom: 1px solid #eff3f4; }
.edit-bio > view { display: flex; align-items: center; justify-content: space-between; }
.edit-bio > view > text { font-size: 12px; color: #536471; font-variant-numeric: tabular-nums; }
.edit-bio textarea {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-height: 64px;
  padding-top: 8px;
  font-size: 15px;
  line-height: 22px;
  color: #0f1419;
}
.edit-year { border-bottom: 0; }
.edit-disclosure {
  display: block;
  padding: 12px 0 4px;
  font-size: 12px;
  color: #536471;
  line-height: 18px;
}

.edit-note {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  margin: 16px 16px 24px;
  padding: 12px;
  border-radius: 12px;
  background: #f7f9f9;
  font-size: 12px;
  color: #536471;
  line-height: 18px;
}
.edit-note image { flex-shrink: 0; width: 15px; height: 15px; margin-top: 2px; filter: grayscale(1); opacity: 0.7; }

.edit-page .edit-save {
  display: block;
  box-sizing: border-box;
  width: calc(100% - 32px);
  min-width: 0;
  height: 44px;
  line-height: 44px;
  padding: 0;
  margin: 0 16px !important;
  background: #0f1419;
  color: #fff;
  border-radius: 22px;
  font-size: 15px;
  font-weight: 700;
}
.edit-page .edit-save[disabled] { opacity: 0.5; background: #0f1419; color: #fff; }

.edit-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 56px 24px;
  background: #fff;
  color: #536471;
  text-align: center;
  font-size: 14px;
}
.edit-error image { width: 44px; height: 44px; margin-bottom: 6px; filter: grayscale(1); }
.edit-page .edit-error button {
  margin: 12px 0 0 !important;
  padding: 0 22px;
  height: 36px;
  line-height: 36px;
  border-radius: 18px;
  background: #0f1419;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
}

@media (min-width: 500px) {
  .edit-page { max-width: 460px; margin: 0 auto; }
}
