.new-chat { padding: 0 0 24px; background:#fff; }
.new-chat-search { display:flex; align-items:center; gap:8px; height:40px; margin:8px 16px 4px; padding:0 12px; border-radius:20px; background:#eff3f4; }
.new-chat-search image { width:18px; height:18px; flex:none; }
.new-chat-search input { flex:1; min-width:0; height:40px; color:#0f1419; font-size:15px; }
.new-chat-placeholder { color:#536471; }
.new-chat-row { display:flex; align-items:center; gap:12px; padding:12px 16px; }
.new-chat-row--pressed { background:#f7f9f9; }
.new-chat-avatar { width:40px; height:40px; flex:none; border-radius:50%; background:#eff3f4; }
.new-chat-copy { display:flex; flex-direction:column; min-width:0; }
.new-chat-name { color:#0f1419; font-size:15px; font-weight:700; line-height:20px; }
.new-chat-hint { color:#536471; font-size:15px; line-height:20px; }
.new-chat-empty { display:flex; flex-direction:column; align-items:center; padding:64px 32px 0; text-align:center; }
.new-chat-symbol { width:64px; height:64px; opacity:.9; }
.new-chat-empty-title { margin-top:20px; color:#0f1419; font-size:31px; font-weight:800; line-height:36px; }
.new-chat-empty-copy { margin-top:8px; color:#536471; font-size:15px; line-height:20px; }
.new-chat-primary { min-width:0; margin-top:24px; padding:0 24px; height:36px; line-height:36px; border-radius:18px; background:#0f1419; color:#fff; font-size:15px; font-weight:700; }
