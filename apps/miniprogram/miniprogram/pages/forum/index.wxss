.forum-navigation { position: sticky; top: 0; z-index: 20; background: var(--xlk-color-background); }
.forum-home { padding: 12rpx 28rpx calc(156rpx + env(safe-area-inset-bottom)); }
.forum-heading { display: flex; align-items: center; justify-content: space-between; height: 72rpx; }
.forum-heading-title { display: flex; align-items: center; font-size: 26rpx; font-weight: 600; color: var(--xlk-color-primary-strong); }
.forum-dot { width: 10rpx; height: 10rpx; border-radius: 50%; margin-right: 8rpx; background: var(--xlk-color-primary); }
.forum-home .forum-search { display: flex; align-items: center; justify-content: center; width: 64rpx; min-width: 64rpx; height: 64rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: var(--xlk-color-surface); }
.forum-search-icon { width: 32rpx; height: 32rpx; }
.forum-search::after, .forum-category::after, .forum-announcement::after { border: 0; }
.forum-category-scroll { width: 100%; margin: 8rpx 0 20rpx; }
.forum-categories { display: flex; align-items: center; white-space: nowrap; }
.forum-home .forum-category {
  position: relative; flex: 0 0 auto; width: auto; min-width: 0; max-width: none; height: 60rpx;
  padding: 0; margin: 0 24rpx 0 0; border: 0; border-radius: 0; background: transparent;
  font-size: 25rpx; font-weight: 400; line-height: 52rpx; color: #6E7889;
}
.forum-home .forum-category:last-child { margin-right: 0; }
.forum-home .forum-category--selected { color: var(--xlk-color-primary-strong); font-weight: 600; }
.forum-category--selected::before { content: ''; position: absolute; bottom: 0; left: 50%; width: 32rpx; height: 5rpx; margin-left: -16rpx; border-radius: 5rpx; background: var(--xlk-color-primary); }
.forum-home .forum-announcement {
  display: flex; align-items: center; width: 100%; min-width: 0; height: 80rpx; margin: 0 0 24rpx; padding: 0 16rpx;
  border: 0; border-radius: var(--xlk-radius-md); background: var(--xlk-color-primary-soft); text-align: left;
  font-size: 23rpx; font-weight: 400; line-height: 1.5;
}
.forum-announcement-icon { display: flex; flex: 0 0 48rpx; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; border-radius: 50%; background: #DDE8FC; margin-right: 12rpx; }
.forum-announcement-symbol { width: 28rpx; height: 28rpx; }
.forum-announcement-label { flex-shrink: 0; color: var(--xlk-color-primary-strong); font-weight: 600; margin-right: 12rpx; }
.forum-announcement-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #5C687C; }
.forum-announcement-arrow { width: 24rpx; height: 24rpx; flex-shrink: 0; margin-left: 8rpx; }
.forum-feed-item { margin-bottom: 24rpx; }
.forum-feed-end { display: flex; align-items: center; justify-content: center; padding: 20rpx 0 32rpx; font-size: 21rpx; color: var(--xlk-color-muted); }
.forum-end-dot { width: 8rpx; height: 8rpx; background: #D8DFEC; border-radius: 50%; margin: 0 12rpx; }
.forum-empty { text-align: center; padding: 96rpx 12rpx; color: var(--xlk-color-muted); font-size: 25rpx; }
