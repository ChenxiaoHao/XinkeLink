/* 首页：对称顶栏 + 横向可滚板块栏（右侧柔和渐变遮罩）+ 极简公告细条 + 帖子流。 */
.forum-navigation { position: sticky; top: 0; z-index: 120; background: #fff; }
.forum-home { background: #fff; min-height: 75vh; padding-bottom: calc(96px + env(safe-area-inset-bottom)); }

.timeline-tabs-wrap { position: relative; border-bottom: 1px solid #eff3f4; }
.timeline-tabs { display: flex; height: 46px; white-space: nowrap; }
.timeline-tabs-fade {
  pointer-events: none;
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 28px;
  background: linear-gradient(to right, rgba(255, 255, 255, 0), #ffffff);
}
.timeline-tab {
  position: relative;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  width: auto;
  height: 46px;
  margin: 0;
  padding: 0 14px;
  background: transparent;
  color: #536471;
  font-size: 15px;
  font-weight: 500;
  border-radius: 0;
}
.timeline-tab text { line-height: 20px; }
.timeline-tab-underline {
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 0;
  height: 3px;
  border-radius: 2px;
  background: transparent;
}
.timeline-tab--active { color: #0f1419; font-weight: 700; }
.timeline-tab--active .timeline-tab-underline { background: #0f1419; }

.feed-announcement {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 10px 16px 2px;
  padding: 8px 12px;
  border-radius: 12px;
  background: #f7f9f9;
}
.feed-announcement:active { background: #eff3f4; }
.feed-announcement-dot { width: 6px; height: 6px; border-radius: 50%; background: #0f1419; flex: none; }
.feed-announcement-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #536471;
  font-size: 12px;
  line-height: 18px;
}

.forum-feed-item { border-bottom: 1px solid #eff3f4; }
.forum-feed-end { padding: 24px 16px; text-align: center; font-size: 13px; color: #536471; }
.feed-page-retry { width: fit-content; margin: 0 auto; padding: 4px 12px; color: #0f1419; background: #f7f9f9; font-size: 13px; line-height: 28px; }

.feed-state { padding: 48px 32px; max-width: 400px; margin: auto; color: #536471; font-size: 15px; line-height: 1.5; }
.feed-state-title { display: block; color: #0f1419; font-size: 20px; font-weight: 800; margin-bottom: 8px; }
.feed-state button {
  width: max-content;
  min-width: 0;
  margin: 24px 0 0 !important;
  padding: 0 22px;
  height: 38px;
  background: #0f1419;
  color: #fff;
  border-radius: 19px;
  font-size: 15px;
  font-weight: 700;
  line-height: 38px;
}
