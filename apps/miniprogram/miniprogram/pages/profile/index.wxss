/* 17 · 个人主页：严格对齐总设计画布 —— 深灰蓝磨砂封面 + 82px 压边头像 + 右侧紧凑胶囊钮 + 双 Tab */
.profile-page { min-height: 100vh; background: #fff; padding-bottom: calc(32px + env(safe-area-inset-bottom)); }

.profile-cover { position: relative; height: 150px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 55%, #334155 100%); }
.profile-nav { position: absolute; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; height: 44px; padding-left: 14px; box-sizing: content-box; }
.profile-nav-button { display: flex; align-items: center; justify-content: center; width: 32px; min-width: 32px; max-width: 32px; height: 32px; min-height: 32px; max-height: 32px; margin: 0; padding: 0; border-radius: 50%; background: rgba(0, 0, 0, .45); }
.profile-nav-button image { width: 17px; height: 17px; }
.profile-nav-button:active { background: rgba(0, 0, 0, .62); }

.profile-identity { padding: 0 16px; }
.profile-avatar-row { position: relative; z-index: 2; display: flex; align-items: flex-end; justify-content: space-between; margin-top: -41px; }
.profile-avatar { display: block; flex: none; box-sizing: border-box; width: 82px; height: 82px; border: 4px solid #fff; border-radius: 50%; background: #eff3f4; }
.profile-actions { display: flex; align-items: center; gap: 8px; padding-bottom: 4px; }
.profile-action { flex: none; width: auto; min-width: 0; height: 34px; margin: 0 !important; padding: 0 14px; border: 1px solid #cfd9de; border-radius: 17px; background: #fff; color: #0f1419; font-size: 13px; font-weight: 700; line-height: 32px; text-align: center; }
.profile-action:active { background: #f7f9f9; }

.profile-name { display: block; margin-top: 8px; color: #0f1419; font-size: 20px; font-weight: 800; line-height: 26px; overflow-wrap: anywhere; }
.profile-meta { display: block; margin-top: 2px; color: #536471; font-size: 14px; line-height: 20px; overflow-wrap: anywhere; }
.profile-bio { display: block; margin-top: 8px; color: #0f1419; font-size: 14px; line-height: 20px; overflow-wrap: anywhere; }
.profile-stats { display: flex; gap: 16px; margin-top: 10px; }
.profile-stat { display: flex; align-items: baseline; gap: 4px; }
.profile-stat-number { color: #0f1419; font-size: 14px; font-weight: 700; line-height: 20px; }
.profile-stat-unit { color: #536471; font-size: 14px; line-height: 20px; }

.profile-guest { display: flex; align-items: center; justify-content: space-between; margin: 12px 16px 0; padding: 10px 12px; border-radius: 12px; background: #f7f9f9; }
.profile-guest-copy { color: #536471; font-size: 13px; line-height: 18px; }
.profile-guest-action { min-width: 0; margin: 0; padding: 0 12px; height: 28px; border-radius: 14px; background: #0f1419; color: #fff; font-size: 13px; font-weight: 700; line-height: 28px; }

.profile-tabs { display: flex; margin-top: 14px; border-bottom: 1px solid #eff3f4; }
.profile-tab { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 44px; margin: 0; padding: 0; background: transparent; border-radius: 0; color: #536471; font-size: 15px; font-weight: 500; }
.profile-tab text { line-height: 20px; }
.profile-tab-underline { position: absolute; bottom: 0; width: 0; height: 3px; border-radius: 2px; background: transparent; }
.profile-tab--active { color: #0f1419; font-weight: 700; }
.profile-tab--active .profile-tab-underline { width: 48px; background: #0f1419; }

.profile-post { border-bottom: 1px solid #eff3f4; }
.profile-end { padding: 24px 16px; text-align: center; color: #536471; font-size: 13px; }

.profile-state { padding: 48px 32px; text-align: center; }
.profile-state-title { display: block; color: #0f1419; font-size: 18px; font-weight: 800; line-height: 24px; }
.profile-state-copy { display: block; margin-top: 8px; color: #536471; font-size: 14px; line-height: 20px; }
.profile-state-action { width: max-content; min-width: 0; margin: 20px auto 0 !important; padding: 0 20px; height: 36px; border-radius: 18px; background: #0f1419; color: #fff; font-size: 14px; font-weight: 700; line-height: 36px; }

@media (min-width: 500px) {
  .profile-page { max-width: 460px; margin: 0 auto; }
}
