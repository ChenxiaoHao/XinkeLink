/* 个人主页：X 式主页结构 —— 150 封面 + 88 头像压边 + 统计行 + 双胶囊 + 帖子/喜欢两栏。
   口径为 375 基准的 px；≥500px 收成 460 的窄栏，不放大字号。 */
.profile-page { min-height:100vh; background:#fff; padding-bottom:calc(32px + env(safe-area-inset-bottom)); }

.profile-cover { position:relative; height:150px; background:linear-gradient(118deg,#0b4c78 0%,#0f1419 58%,#7fd0f7 100%); }
.profile-nav { position:absolute; top:0; left:0; right:0; display:flex; align-items:center; justify-content:space-between; height:53px; padding-left:12px; box-sizing:content-box; }
.profile-nav-button { display:flex; align-items:center; justify-content:center; width:34px; min-width:34px; max-width:34px; height:34px; min-height:34px; max-height:34px; margin:0; padding:0; border-radius:17px; background:rgba(0,0,0,.42); }
.profile-nav-button image { width:18px; height:18px; }
.profile-nav-button:active { background:rgba(0,0,0,.58); }

.profile-identity { padding:0 16px; }
/* 封面是定位元素，会盖住静态流里的头像；显式抬高层级才能让头像真的压在封面上。 */
/* 88 是含白色描边的外径（设计稿口径），用 border-box 才不会量成 96。 */
.profile-avatar { display:block; position:relative; z-index:1; box-sizing:border-box; width:88px; height:88px; margin-top:-36px; border:4px solid #fff; border-radius:50%; background:#fff; }
.profile-name { display:block; margin-top:4px; color:#0f1419; font-size:20px; font-weight:800; line-height:26px; overflow-wrap:anywhere; }
.profile-meta { display:block; margin-top:2px; color:#536471; font-size:15px; line-height:20px; overflow-wrap:anywhere; }
.profile-bio { display:block; margin-top:10px; color:#0f1419; font-size:15px; line-height:20px; overflow-wrap:anywhere; }
.profile-stats { display:flex; gap:20px; margin-top:12px; }
.profile-stat { display:flex; align-items:baseline; gap:4px; }
.profile-stat-number { color:#0f1419; font-size:15px; font-weight:700; line-height:20px; }
.profile-stat-unit { color:#536471; font-size:15px; line-height:20px; }
.profile-actions { display:flex; gap:8px; margin-top:12px; }
.profile-action { flex:1; min-width:0; height:36px; margin:0; padding:0 8px; border:1px solid #cfd9de; border-radius:18px; background:#fff; color:#0f1419; font-size:14px; font-weight:700; line-height:34px; text-align:center; }
.profile-action:active { background:#f7f9f9; }

.profile-guest { display:flex; align-items:center; justify-content:space-between; margin:12px 16px 0; padding:10px 12px; border-radius:12px; background:#f7f9f9; }
.profile-guest-copy { color:#536471; font-size:13px; line-height:18px; }
.profile-guest-action { min-width:0; margin:0; padding:0 12px; height:28px; border-radius:14px; background:#0f1419; color:#fff; font-size:13px; font-weight:700; line-height:28px; }

.profile-tabs { display:flex; margin-top:16px; border-bottom:1px solid #eff3f4; }
.profile-tab { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; height:48px; margin:0; padding:0; background:transparent; border-radius:0; color:#536471; font-size:15px; font-weight:500; }
.profile-tab text { line-height:20px; }
.profile-tab-underline { width:0; height:4px; margin-top:6px; border-radius:2px; background:transparent; }
.profile-tab--active { color:#0f1419; font-weight:700; }
.profile-tab--active .profile-tab-underline { width:56px; background:#0f1419; }

.profile-post { border-bottom:1px solid #eff3f4; }
.profile-end { padding:24px 16px; text-align:center; color:#536471; font-size:13px; }

.profile-state { padding:48px 32px; text-align:center; }
.profile-state-title { display:block; color:#0f1419; font-size:20px; font-weight:800; line-height:26px; }
.profile-state-copy { display:block; margin-top:8px; color:#536471; font-size:15px; line-height:20px; }
.profile-state-action { width:max-content; min-width:0; margin:20px auto 0 !important; padding:0 20px; height:36px; border-radius:18px; background:#0f1419; color:#fff; font-size:15px; font-weight:700; line-height:36px; }

@media (min-width: 500px) {
  .profile-page { max-width:460px; margin:0 auto; }
}
