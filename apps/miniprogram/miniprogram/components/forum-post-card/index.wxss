.post-card { padding: var(--xlk-space-3); background: var(--xlk-color-surface); border-radius: var(--xlk-radius-md); box-shadow: 0 2rpx 8rpx rgba(42, 64, 97, 0.025); }
.post-header { display: flex; align-items: center; margin-bottom: 24rpx; }
.post-avatar { width: 76rpx; height: 76rpx; flex: 0 0 76rpx; border-radius: 50%; overflow: hidden; }
.post-avatar-image { display: block; width: 100%; height: 100%; }
.post-avatar--anonymous { background: #EDF0F6; display: flex; align-items: center; justify-content: center; }
.post-avatar--anonymous .post-avatar-image { width: 40rpx; height: 40rpx; }
.post-author { display: flex; flex: 1; min-width: 0; flex-direction: column; padding-left: 16rpx; }
.post-name { font-size: 28rpx; font-weight: 600; color: var(--xlk-color-text); line-height: 1.5; }
.post-time { font-size: 20rpx; color: var(--xlk-color-muted); line-height: 1.6; }
.post-more { width: 28rpx; height: 28rpx; align-self: flex-start; margin-top: 8rpx; }
.post-content { display: block; font-size: 26rpx; line-height: 1.75; color: var(--xlk-color-text); white-space: pre-wrap; word-break: break-all; }
.post-images { display: flex; flex-wrap: wrap; margin-top: 24rpx; margin-right: -12rpx; }
.post-image-cell { position: relative; width: calc(33.333333% - 12rpx); margin: 0 12rpx 12rpx 0; border-radius: 14rpx; overflow: hidden; background: var(--xlk-color-primary-soft); }
.post-image-cell::before { content: ''; display: block; padding-top: 100%; }
.post-images--single .post-image-cell { width: calc(100% - 12rpx); }
.post-images--single .post-image-cell::before { padding-top: 66.666667%; }
.post-images--double .post-image-cell, .post-images--quad .post-image-cell { width: calc(50% - 12rpx); }
.post-image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.post-footer { display: flex; align-items: center; margin-top: 12rpx; min-height: 40rpx; }
/* style:v2 applies a width to native buttons. Two-class rules keep actions intrinsic. */
.post-card .post-action {
  display: flex; align-items: center; justify-content: center; flex: 0 0 auto;
  width: auto; min-width: 0; max-width: none; height: 44rpx; min-height: 0;
  margin: 0 28rpx 0 0; padding: 0; border: 0; border-radius: 0;
  background: transparent; font-size: 22rpx; font-weight: 400; line-height: 1; color: #6E7889;
}
.post-action::after { border: 0; }
.post-action-icon, .post-comments-icon { width: 30rpx; height: 30rpx; margin-right: 10rpx; }
.post-comments { display: flex; align-items: center; font-size: 22rpx; color: #6E7889; }
.post-footer-spacer { flex: 1; }
.post-card .post-action--icon { width: 44rpx; margin: 0 0 0 16rpx; }
.post-action--icon .post-action-icon { margin: 0; }
.post-card .post-action--active { color: var(--xlk-color-primary); }
