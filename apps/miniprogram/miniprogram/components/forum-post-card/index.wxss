/* 帖子卡：头像左挂 + 内容列右缩进，动作行三项（评论 / 转发 / 点赞）摊平。
   数值对齐设计稿 375 基准。 */
.post-card { position:relative; padding:12px 16px; background:#fff; color:#0f1419; border-radius:0; }
.post-header { display:flex; align-items:flex-start; height:20px; margin:0 0 4px; }
.post-avatar { position:absolute; left:16px; top:12px; width:40px; height:40px; border-radius:50%; overflow:hidden; background:#eff3f4; }
.post-avatar-image { width:100%; height:100%; }
.post-avatar--anonymous { display:flex; align-items:center; justify-content:center; }
.post-avatar--anonymous .post-avatar-image { width:24px; height:24px; }
.post-author { display:flex; align-items:baseline; flex:1; min-width:0; padding-left:48px; white-space:nowrap; overflow:hidden; line-height:20px; }
.post-name { overflow:hidden; text-overflow:ellipsis; font-size:15px; font-weight:700; }
.post-time { color:#536471; font-size:15px; font-weight:400; flex:none; }
.post-more { display:flex; align-items:center; justify-content:center; width:32px; height:24px; margin:-2px -8px 0 2px; padding:0; background:transparent; }
.post-more image { width:18px; height:18px; }
.post-body { padding-left:48px; }
.post-content { display:block; font-size:15px; line-height:20px; white-space:pre-wrap; word-break:break-word; }
.post-images { display:flex; flex-wrap:wrap; gap:2px; margin-top:10px; overflow:hidden; border:1px solid #cfd9de; border-radius:16px; }
.post-image-cell { position:relative; width:calc((100% - 4px) / 3); overflow:hidden; background:#eff3f4; }
.post-image-cell::before { content:''; display:block; padding-top:100%; }
.post-image { position:absolute; inset:0; width:100%; height:100%; }
.post-images--single .post-image-cell { width:100%; }
.post-images--single .post-image-cell::before { padding-top:var(--post-image-padding,75%); }
.post-images--double .post-image-cell,.post-images--quad .post-image-cell { width:calc(50% - 1px); }
.post-images--double .post-image-cell::before { padding-top:110%; }
.post-image-failed { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:center; align-items:center; font-size:12px; color:#536471; }
.post-image-failed-icon { width:24px; height:24px; margin-bottom:8px; }

/* 动作行：三项等距摊开，命中区 34 高 */
.post-footer { display:flex; align-items:center; justify-content:space-between; height:34px; margin:2px -6px 0; }
.post-action { display:flex; align-items:center; justify-content:flex-start; gap:4px; min-width:34px; height:34px; padding:0 6px; margin:0; background:transparent; color:#536471; font-size:13px; font-weight:400; line-height:1; border-radius:17px; }
.post-action-icon { width:18px; height:18px; }
.post-action:active { background:#eff3f4; }
.post-action--liked { color:#f91880; }
.post-action--liked .post-action-icon { transform:scale(1.05); }
.post-action--reposted { color:#00ba7c; }

/* 详情页：正文占满宽度，动作行放大成 44 高的大按钮 */
/* 详情页头像 48：头部整行必须跟头像一样高，否则头像会压住正文首行。 */
.post-card--detail .post-avatar { width:48px; height:48px; }
.post-card--detail .post-header { height:48px; margin-bottom:0; }
.post-card--detail .post-author { padding-left:56px; }
.post-card--detail .post-body { padding-left:0; margin-top:8px; }
.post-card--detail .post-content { font-size:15px; line-height:20px; }
/* 时间戳行：设计稿把「下午 2:31 · 2026年11月12日」放在媒体下方、动作行上方 */
.post-stamp { display:block; margin-top:12px; color:#536471; font-size:15px; line-height:20px; }
.post-card--detail .post-footer { height:44px; margin:8px -8px 0; }
.post-card--detail .post-action { gap:6px; min-width:44px; height:44px; padding:0 8px; border-radius:22px; font-size:15px; }
.post-card--detail .post-action-icon { width:20px; height:20px; }

@media(min-width:500px) { .post-card { max-width:640px; margin:auto; } }

/* tablet-scale:begin */
@media (min-width: 500px) {
  .post-content, .post-card--detail .post-content { font-size:15px; line-height:20px; }
  .post-card { padding:12px 16px; }
  .post-header { height:20px; }
}
/* tablet-scale:end */

.post-more { min-width:32px; max-width:32px; flex:none; }
.post-action { width:auto; box-sizing:border-box; }
