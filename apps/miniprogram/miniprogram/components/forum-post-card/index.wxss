/* 帖子卡：头像左挂（含极淡描边）+ 内容列右缩进 + 真实可用三键动作行（评论 / 点赞 / 微信原生分享）。 */
.post-card { position: relative; padding: 13px 16px; background: #fff; color: #0f1419; border-radius: 0; }
.post-header { display: flex; align-items: center; height: 22px; margin: 0 0 4px; }
.post-avatar {
  position: absolute;
  left: 16px;
  top: 13px;
  box-sizing: border-box;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 0.5px solid rgba(15, 20, 25, 0.08);
  overflow: hidden;
  background: #eff3f4;
}
.post-avatar-image { width: 100%; height: 100%; }
.post-avatar--anonymous { display: flex; align-items: center; justify-content: center; }
.post-avatar--anonymous .post-avatar-image { width: 22px; height: 22px; }
.post-author {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding-left: 50px;
  white-space: nowrap;
  overflow: hidden;
  line-height: 20px;
}
.post-name { overflow: hidden; text-overflow: ellipsis; font-size: 15px; font-weight: 700; }
.post-time { margin-left: 5px; color: #536471; font-size: 14px; font-weight: 400; flex: none; }
.post-anon-tag {
  flex: none;
  margin-left: 6px;
  padding: 0 6px;
  height: 17px;
  line-height: 17px;
  border-radius: 4px;
  background: #eff3f4;
  color: #536471;
  font-size: 11px;
  font-weight: 600;
}
.post-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  min-width: 32px;
  max-width: 32px;
  flex: none;
  height: 24px;
  margin: 0 -8px 0 2px;
  padding: 0;
  background: transparent;
}
.post-more-icon { width: 18px; height: 18px; }
.post-body { padding-left: 50px; }
.post-content { display: block; font-size: 15px; line-height: 22px; white-space: pre-wrap; word-break: break-word; }
.post-images { display: flex; flex-wrap: wrap; gap: 2px; margin-top: 10px; overflow: hidden; border: 1px solid #cfd9de; border-radius: 16px; }
.post-image-cell { position: relative; width: calc((100% - 4px) / 3); overflow: hidden; background: #eff3f4; }
.post-image-cell::before { content: ''; display: block; padding-top: 100%; }
.post-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.post-images--single .post-image-cell { width: 100%; }
.post-images--single .post-image-cell::before { padding-top: var(--post-image-padding, 75%); }
.post-images--double .post-image-cell,
.post-images--quad .post-image-cell { width: calc(50% - 1px); }
.post-images--double .post-image-cell::before { padding-top: 110%; }
.post-image-failed { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; font-size: 12px; color: #536471; }
.post-image-failed-icon { width: 24px; height: 24px; margin-bottom: 8px; }

/* 动作行：评论 / 点赞 / 微信原生分享 */
@keyframes heartPop {
  0% { transform: scale(1); }
  35% { transform: scale(1.28); }
  70% { transform: scale(0.92); }
  100% { transform: scale(1); }
}
.post-footer { display: flex; align-items: center; justify-content: space-between; height: 34px; margin: 4px -6px 0; padding-right: 12px; }
.post-action {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 5px;
  width: auto;
  min-width: 34px;
  height: 34px;
  padding: 0 8px;
  margin: 0;
  background: transparent;
  color: #536471;
  font-size: 13px;
  font-weight: 400;
  line-height: 1;
  border-radius: 17px;
  box-sizing: border-box;
}
.post-action-icon { width: 18px; height: 18px; }
.post-action:active { background: #eff3f4; }
.post-action--liked { color: #f91880; font-weight: 600; }
.post-action--liked .post-action-icon { animation: heartPop 0.34s cubic-bezier(0.22, 1, 0.36, 1); }

/* 详情页：48px 大头像与昵称垂直居中，时间戳下方加极细分隔线 */
.post-card--detail .post-avatar { width: 48px; height: 48px; }
.post-card--detail .post-header { height: 48px; align-items: center; margin-bottom: 0; }
.post-card--detail .post-author { padding-left: 58px; }
.post-card--detail .post-body { padding-left: 0; margin-top: 12px; }
.post-card--detail .post-content { font-size: 17px; line-height: 26px; }
.post-stamp { display: block; margin-top: 14px; color: #536471; font-size: 14px; line-height: 20px; }
.post-card--detail .post-footer {
  height: 44px;
  margin: 12px -8px 0;
  padding: 6px 16px 0;
  border-top: 1px solid #eff3f4;
}
.post-card--detail .post-action { gap: 6px; min-width: 44px; height: 44px; padding: 0 10px; border-radius: 22px; font-size: 14px; }
.post-card--detail .post-action-icon { width: 20px; height: 20px; }

/* Detail-only media flow */
.post-images--detail { display: block; border: 0; border-radius: 0; gap: 0; overflow: visible; }
.post-images--detail .post-image-cell { box-sizing: border-box; width: 100%; margin-bottom: 8px; border: 1px solid #cfd9de; border-radius: 16px; overflow: hidden; background: #eff3f4; }
.post-images--detail .post-image-cell:last-child { margin-bottom: 0; }
.post-images--detail .post-image-cell::before { display: none; }
.post-images--detail .post-image-cell--pending { min-height: 100px; }
.post-images--detail .post-image { position: static; width: 100%; height: auto; display: block; }
.post-images--detail .post-image-failed { position: relative; min-height: 100px; }
.post-images--detail .post-image--failed { height: 0 !important; overflow: hidden; }

@media (min-width: 500px) { .post-card { max-width: 640px; margin: auto; } }
