<view wx:if="{{post}}" class="post-card">
  <view class="post-header">
    <view class="post-avatar {{post.isAnonymous ? 'post-avatar--anonymous' : ''}}"><image class="post-avatar-image" src="{{post.avatar}}" mode="aspectFill" /></view>
    <view class="post-author"><text class="post-name">{{post.authorName}}</text><text class="post-time">{{post.timeLabel}}</text></view>
    <image class="post-more" src="/assets/icons/ellipsis-muted.png" />
  </view>
  <text class="post-content" user-select>{{post.content}}</text>
  <view wx:if="{{post.images.length}}" class="post-images post-images--{{post.imageLayout}}">
    <view wx:for="{{post.images}}" wx:key="index" class="post-image-cell" data-index="{{index}}" bindtap="onImageTap"><image class="post-image" src="{{item}}" mode="aspectFill" lazy-load /></view>
  </view>
  <view class="post-footer">
    <button class="post-action {{post.liked ? 'post-action--active' : ''}}" bindtap="onLikeTap" aria-label="{{post.liked ? '取消点赞' : '点赞'}}"><image class="post-action-icon" src="/assets/icons/heart-{{post.liked ? 'primary-filled' : 'muted'}}.png" /><text>{{post.likeCount}}</text></button>
    <view class="post-comments" aria-label="{{post.commentCount}}条评论"><image class="post-comments-icon" src="/assets/icons/message-circle-muted.png" /><text>{{post.commentCount}}</text></view>
    <view class="post-footer-spacer" />
    <button class="post-action post-action--icon {{post.collected ? 'post-action--active' : ''}}" bindtap="onCollectTap" aria-label="{{post.collected ? '取消收藏' : '收藏'}}"><image class="post-action-icon" src="/assets/icons/bookmark-{{post.collected ? 'primary-filled' : 'muted'}}.png" /></button>
    <button class="post-action post-action--icon" open-type="share" data-post-id="{{post.id}}" aria-label="分享"><image class="post-action-icon" src="/assets/icons/share-2-muted.png" /></button>
  </view>
</view>
