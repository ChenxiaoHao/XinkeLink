<view wx:if="{{post}}" class="post-card {{detail ? 'post-card--detail' : ''}} {{home ? 'post-card--home' : ''}} {{secondary ? 'post-card--secondary' : ''}}" style="--post-image-padding: {{singleImagePadding}}%;" bindtap="onOpenTap">
  <view class="post-header">
    <view class="post-avatar {{post.isAnonymous ? 'post-avatar--anonymous' : ''}}" catchtap="onAuthorTap">
      <image class="post-avatar-image" src="{{post.avatar}}" data-source="{{post.avatar}}" binderror="onAvatarError" mode="aspectFill" />
    </view>
    <view class="post-author" catchtap="onAuthorTap">
      <text class="post-name">{{post.authorName}}</text>
      <text wx:if="{{post.isAnonymous}}" class="post-anon-tag">匿名</text>
      <text wx:if="{{!detail}}" class="post-time">· {{post.timeLabel}}</text>
    </view>
    <button class="post-more" catchtap="onMoreTap" aria-label="更多操作">
      <image class="post-more-icon" src="/assets/icons/x-ellipsis-muted.png" />
    </button>
  </view>
  <view class="post-body">
    <text class="post-content" user-select>{{post.content}}</text>
    <view wx:if="{{post.images.length}}" class="post-images post-images--{{post.imageLayout}} {{detail ? 'post-images--detail' : ''}} {{home && post.imageLayout === 'single' && singleImagePadding > 105 ? 'post-images--portrait' : ''}}">
      <view wx:for="{{imageSources || post.images}}" wx:key="index" class="post-image-cell {{imageSources && !item && !imageFailures[post.images[index]] ? 'post-image-cell--pending' : ''}}" data-index="{{index}}" catchtap="onImageTap">
        <image class="post-image {{detail && imageFailures[item] ? 'post-image--failed' : ''}}" wx:if="{{imageKey && item}}" src="{{item}}" mode="{{detail ? 'widthFix' : 'aspectFill'}}" data-source="{{item}}" data-index="{{index}}" bindload="onImageLoad" binderror="onImageError" lazy-load="{{!imageSources}}" />
        <view wx:if="{{imageFailures[item || post.images[index]]}}" class="post-image-failed">
          <image class="post-image-failed-icon" src="/assets/icons/camera-primary.png" />
          <text>图片暂时不可用</text>
        </view>
      </view>
    </view>
    <text wx:if="{{detail && post.stamp}}" class="post-stamp">{{post.stamp}}{{post.viewCount ? ' · ' + post.viewCount + ' 次浏览' : ''}}</text>
    <view class="post-footer">
      <button class="post-action" catchtap="onReplyTap" aria-label="评论">
        <image class="post-action-icon" src="/assets/icons/x-message-circle-muted.png" />
        <text wx:if="{{post.commentCount}}">{{post.commentCount}}</text>
      </button>
      <button class="post-action {{!detail && post.reposted ? 'post-action--reposted' : ''}}" catchtap="onRepostTap" aria-label="{{!detail && post.reposted ? '取消转发' : '转发'}}">
        <image class="post-action-icon" src="/assets/icons/x-repeat-2-{{!detail && post.reposted ? 'reposted' : 'muted'}}.png" />
        <text wx:if="{{!detail && post.repostCount}}">{{post.repostCount}}</text>
      </button>
      <button class="post-action {{post.liked ? 'post-action--liked' : ''}}" catchtap="onLikeTap" aria-label="{{post.liked ? '取消点赞' : '点赞'}}">
        <image class="post-action-icon" src="/assets/icons/x-heart-{{post.liked ? 'liked' : 'muted'}}.png" />
        <text wx:if="{{post.likeCount}}">{{post.likeCount}}</text>
      </button>
    </view>
  </view>
</view>
