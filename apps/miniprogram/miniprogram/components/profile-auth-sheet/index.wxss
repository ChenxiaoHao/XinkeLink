.auth-overlay { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: flex-end; background: var(--profile-auth-overlay, rgba(15,20,25,0)); transition: background-color 180ms cubic-bezier(.23,1,.32,1); }
.auth-overlay--open { background: var(--profile-auth-overlay-open, rgba(15,20,25,.38)); }
.auth-sheet { box-sizing: border-box; width: 100%; padding: 12rpx 36rpx calc(28rpx + env(safe-area-inset-bottom)); background: #FFF; border-radius: 48rpx 48rpx 0 0; color: var(--profile-auth-text, #0F1419); transform: translateY(100%); transition: transform 180ms cubic-bezier(.32,.72,0,1); }
.auth-overlay--open .auth-sheet { transform: translateY(0); transition-duration: 220ms; }
.auth-handle { width: 72rpx; height: 8rpx; margin: 8rpx auto 28rpx; border-radius: 999px; background: var(--profile-auth-handle, #CFD9DE); }
.auth-heading { display: flex; align-items: center; gap: 14rpx; font-size: 36rpx; font-weight: 800; color: #0F1419; }
.auth-brand { width: 52rpx; height: 52rpx; filter: var(--profile-auth-brand-filter, grayscale(1) brightness(0)); }
.auth-sheet .auth-close { display: flex; align-items: center; justify-content: center; flex: none; width: 34px; min-width: 34px; height: 34px; margin: 0 0 0 auto; padding: 0; border-radius: 50%; background: #F7F9F9; }
.auth-close-icon { width: 32rpx; height: 32rpx; filter: var(--profile-auth-icon-filter, grayscale(1)); }
.auth-description { display: block; margin: 14rpx 0 24rpx; font-size: 26rpx; line-height: 1.5; color: var(--profile-auth-muted, #536471); }
.auth-row { display: flex; align-items: center; min-height: 108rpx; border-bottom: 1rpx solid var(--profile-auth-border, #EFF3F4); font-size: 30rpx; }
.auth-row-label { flex: none; width: 96rpx; font-weight: 600; color: #0F1419; }
.auth-sheet .auth-avatar { display: flex; align-items: center; justify-content: flex-end; flex: 1; width: auto; min-width: 0; padding: 12rpx 0; margin: 0; background: transparent; color: var(--profile-auth-muted, #536471); font-size: 28rpx; font-weight: 400; }
.auth-avatar-image { width: 76rpx; height: 76rpx; margin-right: 16rpx; border-radius: 50%; background: var(--profile-auth-avatar-background, #EFF3F4); border: 1rpx solid rgba(15,20,25,0.08); }
.auth-avatar .auth-arrow { width: 28rpx; height: 28rpx; margin-left: 8rpx; filter: var(--profile-auth-icon-filter, grayscale(1)); }
.auth-nickname-input { flex: 1; min-width: 0; height: 88rpx; text-align: right; font-size: 30rpx; color: #0F1419; }
.auth-error { display: block; margin-top: 18rpx; color: var(--profile-auth-error, #F4212E); font-size: 26rpx; }
.auth-legal { margin-top: 20rpx; font-size: 24rpx; line-height: 1.5; color: var(--profile-auth-muted, #536471); text-align: center; }
.auth-legal-link { color: #0F1419; font-weight: 600; }
.auth-sheet .auth-confirm { width: 100%; margin: 32rpx 0 0; border-radius: 999px; background: var(--profile-auth-primary, #0F1419); color: #FFF; font-size: 30rpx; line-height: 92rpx; font-weight: 700; }
.auth-sheet .auth-cancel { width: auto; min-width: 88rpx; min-height: 76rpx; margin: 8rpx auto 0; padding: 0 24rpx; background: transparent; color: var(--profile-auth-muted, #536471); font-size: 28rpx; line-height: 76rpx; font-weight: 500; }
.auth-submit-disabled { opacity: .65; }
.auth-close::after, .auth-avatar::after, .auth-confirm::after, .auth-cancel::after { border: 0; }
@media (prefers-reduced-motion: reduce) { .auth-overlay, .auth-sheet { transition: none; } }

/* tablet-scale:begin */
@media (min-width: 500px) {
  .auth-sheet { width: 100%; padding: 6px 18px calc(14px + env(safe-area-inset-bottom)); border-radius: 24px 24px 0 0; }
  .auth-handle { width: 36px; height: 4px; margin: 4px auto 14px; border-radius: 999px; }
  .auth-heading { gap: 7px; font-size: 18px; }
  .auth-brand { width: 26px; height: 26px; }
  .auth-sheet .auth-close { width: 34px; min-width: 34px; height: 34px; margin: 0 0 0 auto; padding: 0; }
  .auth-close-icon { width: 16px; height: 16px; }
  .auth-description { margin: 7px 0 12px; font-size: 13px; line-height: 1.5; }
  .auth-row { min-height: 54px; border-bottom: 0.5px solid var(--profile-auth-border, #EFF3F4); font-size: 15px; }
  .auth-row-label { width: 48px; }
  .auth-sheet .auth-avatar { width: auto; min-width: 0; padding: 6px 0; margin: 0; font-size: 14px; }
  .auth-avatar-image { width: 38px; height: 38px; margin-right: 8px; border-radius: 50%; }
  .auth-avatar .auth-arrow { width: 14px; height: 14px; margin-left: 4px; }
  .auth-nickname-input { min-width: 0; height: 44px; font-size: 15px; }
  .auth-error { margin-top: 9px; font-size: 13px; }
  .auth-sheet .auth-confirm { width: 100%; margin: 16px 0 0; border-radius: 999px; font-size: 15px; line-height: 46px; }
  .auth-sheet .auth-cancel { width: auto; min-width: 44px; min-height: 38px; margin: 4px auto 0; padding: 0 12px; font-size: 14px; line-height: 38px; }
}
/* tablet-scale:end */

@media (min-width: 500px) { .auth-overlay { justify-content: center; } .auth-sheet { max-width: 460px; } }
