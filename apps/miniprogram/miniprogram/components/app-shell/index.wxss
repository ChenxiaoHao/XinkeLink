.app-shell { position: relative; min-height: 100vh; background: #fff; }
.app-shell--open { height: 100vh; overflow: hidden; }
.account-panel {
  position: fixed;
  inset: 0 auto 0 0;
  width: 80vw;
  box-sizing: border-box;
  background: #fff;
  z-index: 0;
  visibility: hidden;
}
.app-shell--open .account-panel { visibility: visible; }
.account-scroll { height: 100%; box-sizing: border-box; }
.account-top { display: flex; align-items: center; justify-content: space-between; padding: 0 24px; }
.account-avatar {
  box-sizing: border-box;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 0.5px solid rgba(15, 20, 25, 0.08);
  background: #eff3f4;
}
.account-name { padding: 10px 24px 0; font-size: 20px; font-weight: 800; line-height: 1.3; color: #0f1419; }
.account-handle { display: block; padding: 3px 24px 0; color: #536471; font-size: 14px; line-height: 1.4; }
.account-login-wrap { padding: 16px 24px 0; }
.account-login {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 42px;
  margin: 0;
  padding: 0;
  border-radius: 21px;
  background: #0f1419;
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  line-height: 42px;
}
.account-counts {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 12px 24px 18px;
  font-size: 14px;
  color: #536471;
  white-space: nowrap;
}
.account-number { color: #0f1419; font-weight: 700; }
.account-number--second { margin-left: 12px; }
.account-links--guest { margin-top: 20px; padding-top: 12px; border-top: 1px solid #eff3f4; }
.account-links .account-row {
  display: flex;
  align-items: center;
  gap: 18px;
  width: 100%;
  min-width: 0;
  height: 48px;
  padding: 0 24px;
  margin: 0;
  border-radius: 0;
  background: #fff;
  color: #0f1419;
  text-align: left;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.3;
}
.account-links .account-row-icon { width: 22px; height: 22px; flex: none; }
.account-row--pressed { background: #f7f9f9 !important; }
.account-secondary { border-top: 1px solid #eff3f4; margin: 16px 24px 0; padding: 10px 0; }
.account-secondary-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  height: 44px;
  padding: 0;
  margin: 0;
  border-radius: 0;
  background: #fff;
  color: #f4212e;
  text-align: left;
  font-size: 16px;
  font-weight: 600;
  white-space: nowrap;
}
.account-secondary-item--pressed { background: #f7f9f9; }
.account-value { margin-left: auto; color: #536471; font-size: 13px; font-weight: 400; }
.account-chevron { width: 15px !important; height: 15px !important; flex: none; opacity: 0.7; transform: rotate(0); transition: transform 0.18s; }
.account-chevron--open { transform: rotate(180deg); }
.account-prefs { padding: 2px 24px 10px 64px; }
.pref-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 0; }
.pref-title { font-size: 15px; font-weight: 500; color: #0f1419; }
.account-footer { padding: 18px 24px calc(24px + env(safe-area-inset-bottom)); color: #536471; font-size: 12px; }
.shell-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  background: #fff;
  transform: translateX(0);
  transition: transform 0.24s cubic-bezier(0.2, 0.8, 0.2, 1), border-radius 0.24s;
  transform-origin: left center;
}
.shell-content--shifted {
  transform: translateX(80vw);
  border-radius: 24px;
  box-shadow: -10px 0 28px rgba(15, 20, 25, 0.1);
  overflow: hidden;
  height: 100vh;
}
.shell-dismiss { position: absolute; inset: 0; z-index: 500; background: rgba(15, 20, 25, 0.08); }
.shell-content--shifted .shell-dismiss { position: fixed; }
@media (prefers-reduced-motion: reduce) { .shell-content { transition: none; } }
