.app-shell{position:relative;min-height:100vh;background:#fff}.app-shell--open{height:100vh;overflow:hidden}.account-panel{position:fixed;inset:0 auto 0 0;width:80vw;box-sizing:border-box;background:#fff;z-index:0;visibility:hidden}.app-shell--open .account-panel{visibility:visible}.account-scroll{height:100%;box-sizing:border-box}.account-top{display:flex;align-items:center;justify-content:space-between;padding:0 32px}.account-avatar{width:42px;height:42px;border-radius:50%}.account-add{display:flex;align-items:center;justify-content:center;width:34px;min-width:34px;height:34px;padding:0;margin:0;background:transparent}.account-add image{width:25px;height:25px}.account-name{padding:8px 32px 0;font-size:20px;font-weight:750;line-height:1.35}.account-handle{display:block;padding:3px 32px 0;color:#536471;font-size:15px}.account-counts{display:flex;align-items:center;gap:5px;padding:13px 32px 21px;font-size:15px;color:#536471;white-space:nowrap}.account-number{color:#0f1419}.account-number--second{margin-left:10px}.account-links button{display:flex;align-items:center;gap:26px;width:100%;min-width:0;height:54px;padding:0 32px;margin:0;border-radius:0;background:#fff;color:#0f1419;text-align:left;font-size:22px;font-weight:750;line-height:1.3}.account-links image{width:26px;height:26px;flex:none}.account-link--pressed{background:#eff3f4}
/* 次级区只放「退出登录」；主列表所有行统一 54 高 / 22px/750 / 26 图标，与 X 抽屉一致。 */
.account-secondary{border-top:1px solid #eff3f4;margin:23px 24px 0;padding:12px 0}
.account-secondary-item{display:flex;align-items:center;width:100%;min-width:0;height:48px;padding:0 8px;margin:0;border-radius:0;background:#fff;color:#f4212e;text-align:left;font-size:17px;font-weight:500;white-space:nowrap}.account-secondary-item--pressed{background:#eff3f4}
.account-value{margin-left:auto;color:#536471;font-size:15px;font-weight:400}.account-chevron{width:16px;height:16px;flex:none;opacity:.7;transform:rotate(0);transition:transform .18s}.account-chevron--open{transform:rotate(180deg)}
/* 通知偏好折叠面板：标题 15/700 + 说明 13 灰 + 右侧蓝色开关。 */
.account-prefs{padding:2px 8px 6px 53px}.pref-row{display:flex;align-items:center;gap:12px;padding:9px 0}.pref-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}.pref-title{font-size:15px;font-weight:700;color:#0f1419}.pref-note{font-size:13px;color:#536471}.pref-foot{display:block;padding:8px 0 2px;font-size:12px;color:#536471;line-height:1.4}
.account-footer{padding:18px 32px calc(25px + env(safe-area-inset-bottom));color:#536471;font-size:13px}
.account-new{margin-left:-12px;padding:2px 7px;border-radius:12px;background:#fff4e8;color:#ed8a23;font-size:14px}.account-pending{margin-left:-14px;padding:2px 7px;border-radius:10px;background:#eff3f4;color:#536471;font-size:13px;font-weight:500;white-space:nowrap}.shell-content{position:relative;z-index:1;min-height:100vh;background:#fff;transform:translateX(0);transition:transform .24s cubic-bezier(.2,.8,.2,1),border-radius .24s;transform-origin:left center}.shell-content--shifted{transform:translateX(80vw);border-radius:26px;box-shadow:-8px 0 30px #00000014;overflow:hidden;height:100vh}.shell-dismiss{position:absolute;inset:0;z-index:500;background:#ffffff40}.shell-content--shifted .shell-dismiss{position:fixed}@media(prefers-reduced-motion:reduce){.shell-content{transition:none}}

/* 访客登录入口：昵称下方的蓝色胶囊，点击弹出微信头像昵称授权。 */
/* 微信 button 的默认 margin 会吃掉自定义缩进，外面包一层 padding 容器保证与菜单行对齐。 */
.account-login-wrap { padding:14px 32px 0; }
.account-login { display:flex; align-items:center; justify-content:center; width:100%; min-width:0; height:48px; margin:0; padding:0; border-radius:24px; background:#0f1419; color:#fff; font-size:17px; font-weight:700; line-height:48px; }
