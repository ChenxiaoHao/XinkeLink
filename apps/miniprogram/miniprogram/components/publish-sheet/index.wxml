<view wx:if="{{visible}}" class="publish-overlay" bindtap="close" catchtouchmove="stopTap">
  <view class="publish-sheet" catchtap="stopTap" aria-label="选择发布类型" aria-role="dialog">
    <view class="sheet-handle" />
    <view class="sheet-heading">
      <view>
        <text class="sheet-title">选择发布类型</text>
        <text class="sheet-subtitle">记录日常点滴灵感，连接身边的同学</text>
      </view>
      <button class="sheet-close" bindtap="close" hover-class="control-pressed" aria-label="关闭">
        <image src="/assets/icons/x-muted.png" mode="aspectFit" />
      </button>
    </view>
    <view class="publish-options">
      <button class="publish-card publish-card--post" data-type="post" bindtap="choose" hover-class="control-pressed">
        <view class="card-icon card-icon--post">
          <image src="/assets/icons/notebook-pen-primary.png" mode="aspectFit" />
        </view>
        <view class="card-dot" />
        <text class="card-title">发布帖子</text>
        <text class="card-description">分享校园生活，讨论与互助</text>
        <view class="card-link card-link--post">
          <text>立即编辑</text>
          <image src="/assets/icons/arrow-right-primary.png" mode="aspectFit" />
        </view>
      </button>
      <button class="publish-card" data-type="product" bindtap="choose" hover-class="control-pressed">
        <view class="card-icon">
          <image src="/assets/icons/archive-muted.png" mode="aspectFit" />
        </view>
        <text class="card-title">发布闲置</text>
        <text class="card-description">转让课本数码，出闲置好物</text>
        <view class="card-link">
          <text>进入集市</text>
          <image src="/assets/icons/arrow-right-muted.png" mode="aspectFit" />
        </view>
      </button>
    </view>
    <view class="sheet-notice">
      <image src="/assets/icons/leaf-primary.png" mode="aspectFit" />
      <text>绿色校园环境 · 禁止商业广告与违规交易</text>
    </view>
  </view>
</view>
